// ─── Scrape live games (with scroll-through for virtual list) ─────────────────
async function scrapeTennisGames(page) {
  // Expand collapsed sections
  await page.evaluate((sel) => {
    document.querySelectorAll(sel).forEach(b => b.click());
  }, SEL.collapsed).catch(() => {});
  await sleep(200);

  // Scroll to top first
  await page.evaluate(() => window.scrollTo(0, 0)).catch(() => {});
  await sleep(100);

  const allGames = [];
  const seen = new Set();

  // Scroll through entire page accumulating games
  for (let pass = 0; pass < 30; pass++) {
    const viewport = await page.evaluate((sel) => {
      const results = [];
      const blocks = Array.from(document.querySelectorAll(sel.gameBlock))
        .filter(b => b.querySelector(sel.gameBlockFilter));

      for (const block of blocks) {
        const rect = block.getBoundingClientRect();
        if (rect.width === 0 || rect.x >= 700) continue;

        // Teams
        const teams = [];
        block.querySelectorAll(sel.teamName).forEach(el => {
          const name = (el.textContent || '').trim();
          if (name && name.length > 1) teams.push(name);
        });
        if (teams.length < 2) continue;

        // All odds buttons
        const odds = [];
        block.querySelectorAll(sel.oddsButton).forEach((btn, idx) => {
          const val   = (btn.querySelector(sel.oddsValue)  || btn).textContent.trim();
          const title = (btn.querySelector(sel.oddsTitle)  || { textContent: '' }).textContent.trim();
          const pts   = (btn.querySelector(sel.oddsPoints) || { textContent: '' }).textContent.trim();
          odds.push({ val, title, pts, idx });
        });

        // Filter to moneyline only (no O/U title, no spread points)
        const ml = odds.filter(o => {
          const t = o.title.toUpperCase();
          const p = o.pts.trim();
          if (t === 'O' || t === 'U' || t === 'OVER' || t === 'UNDER') return false;
          if (p.startsWith('+') || p.startsWith('-')) return false;
          return true;
        });

        if (ml.length < 2) continue;

        results.push({
          team1: teams[0], team2: teams[1],
          ml1: { odds: ml[0].val, idx: ml[0].idx },
          ml2: { odds: ml[ml.length - 1].val, idx: ml[ml.length - 1].idx },
          allOddsDebug: odds.slice(0, 6).map(o => `[${o.title}|${o.pts}|${o.val}]`).join(' '),
        });
      }
      return results;
    }, SEL).catch(() => []);

    let added = 0;
    for (const g of viewport) {
      const key = [g.team1, g.team2].sort().join('|').toLowerCase();
      if (!seen.has(key)) { seen.add(key); allGames.push(g); added++; }
    }

    // Scroll down one viewport
    const atBottom = await page.evaluate(() => {
      window.scrollBy(0, window.innerHeight * 0.8);
      return window.scrollY + window.innerHeight >= document.body.scrollHeight - 50;
    }).catch(() => true);
    await sleep(200);

    if (atBottom && added === 0) break;
    if (atBottom) break;
  }

  await page.evaluate(() => window.scrollTo(0, 0)).catch(() => {});
  return allGames;
}

// ─── Click a game's ML odds button (scrolls game into view first) ─────────────
async function clickMLButton(page, team1, team2, buttonIdx) {
  // First scroll the game into view
  await page.evaluate((t1, t2, sel) => {
    const norm = s => (s || '').replace(/\s+/g, ' ').trim();
    const blocks = Array.from(document.querySelectorAll(sel.gameBlock))
      .filter(b => b.querySelector(sel.gameBlockFilter));
    const block = blocks.find(b => {
      const names = Array.from(b.querySelectorAll(sel.teamName)).map(el => norm(el.textContent));
      return names.includes(norm(t1)) && names.includes(norm(t2));
    });
    if (block) block.scrollIntoView({ block: 'center', behavior: 'instant' });
  }, team1, team2, SEL).catch(() => {});
  await sleep(300);

  // Now click by index
  return page.evaluate((t1, t2, idx, sel) => {
    const norm = s => (s || '').replace(/\s+/g, ' ').trim();
    const blocks = Array.from(document.querySelectorAll(sel.gameBlock))
      .filter(b => b.querySelector(sel.gameBlockFilter));
    const block = blocks.find(b => {
      const names = Array.from(b.querySelectorAll(sel.teamName)).map(el => norm(el.textContent));
      return names.includes(norm(t1)) && names.includes(norm(t2));
    });
    if (!block) return null;
    const buttons = block.querySelectorAll(sel.oddsButton);
    if (idx >= 0 && idx < buttons.length) { buttons[idx].click(); return 'clicked'; }
    return null;
  }, team1, team2, buttonIdx, SEL);
}

