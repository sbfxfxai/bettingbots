// ─── Login (copied verbatim from four.mjs — proven working) ──────────────────
async function isLoggedIn(page) {
  const result = await page.evaluate(() => {
    const text = (document.body?.innerText || '').toLowerCase();
    if (text.length < 100) return { logged: false, reason: 'page_too_short' };
    const negatives = [
      'log in to place bets', 'sign in to place bets',
      'log in to place', 'sign in to place',
      'want to start placing bets', 'must be logged in',
      'sign in to your account', 'log in to your account',
      'sign in to get started',
    ];
    const negHit = negatives.find(p => text.includes(p));
    if (negHit) return { logged: false, reason: `negative: "${negHit}"` };
    for (const el of document.querySelectorAll('a, button, span')) {
      const t = (el.textContent || '').trim().toLowerCase();
      if (t.length > 20) continue;
      if (t === 'sign in' || t === 'log in') {
        const rect = el.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) return { logged: false, reason: `button: "${t}"` };
      }
    }
    if (/balance[^a-z]*\$\d+/i.test(document.body?.innerText || '')) return { logged: true, reason: 'balance_dollar' };
    if (text.includes('my bets') && !text.includes('sign in') && !text.includes('log in')) return { logged: true, reason: 'my_bets_no_signin' };
    if (text.includes('last login:')) return { logged: true, reason: 'last_login_text' };
    for (const el of document.querySelectorAll('a, button, span, div')) {
      const t = (el.textContent || '').trim().toLowerCase();
      if (t.length > 20) continue;
      if (t === 'sign out' || t === 'log out' || t === 'logout' || t === 'signout') return { logged: true, reason: `found: "${t}"` };
    }
    if (text.length > 2000 && text.includes('deposit') && !text.includes('sign in') && !text.includes('log in')) return { logged: true, reason: 'deposit_no_signin' };
    return { logged: false, reason: 'no_indicator' };
  }).catch(() => ({ logged: false, reason: 'error' }));
  if (result.logged) log(`  🔓 isLoggedIn=true (${result.reason})`);
  return result.logged;
}

async function detectNotLoggedIn(page) {
  return page.evaluate(() => {
    const text = (document.body?.innerText || '').toLowerCase();
    if (text.length < 50) return { notLoggedIn: false, loading: true };
    for (const el of document.querySelectorAll('a, button, span')) {
      const t = (el.textContent || '').trim().toLowerCase();
      if (t.length > 30) continue;
      if (t === 'sign in' || t === 'log in' || t === 'sign up' || t === 'create account') {
        const rect = el.getBoundingClientRect();
        // Must be a real button — wide enough, tall enough, not a tiny nav link
        if (rect.width > 60 && rect.height > 25) return { notLoggedIn: true, reason: t };
      }
    }
    if (/want to start placing bets|must be logged in|sign in to your account/i.test(text)) return { notLoggedIn: true, reason: 'text_prompt' };
    return { notLoggedIn: false, loading: text.length < 500 };
  }).catch(() => ({ notLoggedIn: false, loading: true }));
}

async function performLogin(page) {
  const currentUrl = page.url();
  const onLoginPage = currentUrl.includes('auth/login') || currentUrl.includes('myaccount.draftkings.com');
  if (!onLoginPage) {
    log('  Clicking "Sign In" to open login page...');
    try {
      await Promise.all([
        page.waitForNavigation({ waitUntil: 'domcontentloaded', timeout: 20000 }).catch(() => {}),
        page.evaluate(() => {
          for (const el of document.querySelectorAll('a, button, span')) {
            const t = (el.textContent || '').trim().toLowerCase();
            if (t === 'sign in' || t === 'log in') { el.click(); return true; }
          }
          return false;
        })
      ]);
    } catch {}
    await sleep(3000);
  }
  log('  Waiting for login form...');
  let formFound = false;
  for (let w = 0; w < 20; w++) {
    formFound = await page.evaluate(() => !!(
      document.querySelector('#login-username-input') ||
      document.querySelector('input[type="email"]') ||
      document.querySelector('input[type="text"]')
    )).catch(() => false);
    if (formFound) break;
    await sleep(1000);
  }
  // Fill email via React setter
  const emailFilled = await page.evaluate((email) => {
    const selectors = ['#login-username-input', 'input[type="email"]', 'input[name="Email"]', 'input[autocomplete="email"]', 'input[autocomplete="username"]'];
    for (const sel of selectors) {
      const input = document.querySelector(sel);
      if (!input) continue;
      const rect = input.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) continue;
      input.focus(); input.value = '';
      const setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
      setter.call(input, email);
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.dispatchEvent(new Event('change', { bubbles: true }));
      return sel;
    }
    return null;
  }, DK_EMAIL).catch(() => null);

  if (emailFilled) {
    log(`  Email filled via: ${emailFilled}`);
    await sleep(500);
    const pwFilled = await page.evaluate((pw) => {
      const input = document.querySelector('#login-password-input') || document.querySelector('input[type="password"]');
      if (!input) return false;
      input.focus(); input.value = '';
      const setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
      setter.call(input, pw);
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.dispatchEvent(new Event('change', { bubbles: true }));
      return true;
    }, DK_PASSWORD).catch(() => false);
    if (pwFilled) {
      log('  Password filled — clicking submit...');
      await sleep(300);
      try {
        await Promise.all([
          page.waitForNavigation({ waitUntil: 'domcontentloaded', timeout: 20000 }).catch(() => {}),
          page.evaluate(() => {
            for (const el of document.querySelectorAll('button[type="submit"], button')) {
              const t = (el.textContent || '').trim().toLowerCase();
              if (t === 'log in' || t === 'sign in' || t === 'submit' || t === 'login') { el.click(); return true; }
            }
            return false;
          })
        ]);
      } catch {}
      log('  DOM login submitted');
    }
  } else {
    // Keyboard fallback
    log('  DOM fill failed — keyboard fallback...');
    const inputPos = await page.evaluate(() => {
      for (const input of document.querySelectorAll('input[type="email"], input[type="text"]')) {
        const r = input.getBoundingClientRect();
        if (r.width > 30 && r.height > 10) { input.focus(); return { x: r.x + r.width / 2, y: r.y + r.height / 2 }; }
      }
      return null;
    }).catch(() => null);
    if (inputPos) {
      await page.mouse.click(inputPos.x, inputPos.y);
      await sleep(200);
      await page.keyboard.down('Control'); await page.keyboard.press('a'); await page.keyboard.up('Control');
      await page.keyboard.press('Backspace');
      await page.keyboard.type(DK_EMAIL, { delay: 20 });
      await page.keyboard.press('Tab');
      await sleep(200);
      await page.keyboard.down('Control'); await page.keyboard.press('a'); await page.keyboard.up('Control');
      await page.keyboard.press('Backspace');
      await page.keyboard.type(DK_PASSWORD, { delay: 20 });
      await page.keyboard.press('Enter');
      log('  Keyboard login submitted');
    }
  }
  await sleep(10000);
  if (!page.url().includes('sportsbook.draftkings.com/live')) {
    try { await page.goto('https://sportsbook.draftkings.com/live', { waitUntil: 'domcontentloaded', timeout: 30000 }); } catch {}
    await sleep(5000);
  }
}

async function ensureLoggedIn(page) {
  log('🔑 Checking login status...');
  for (let attempt = 0; attempt < 15; attempt++) {
    if (await isLoggedIn(page)) { log('✅ Logged in to DraftKings — confirmed'); return true; }
    const detection = await detectNotLoggedIn(page);
    log(`  Login attempt ${attempt + 1}/15: notLoggedIn=${detection.notLoggedIn}, reason=${detection.reason || 'n/a'}, loading=${detection.loading || false}`);
    if (detection.notLoggedIn) {
      await performLogin(page);
      await sleep(3000);
      if (await isLoggedIn(page)) { log('✅ Logged in — confirmed after auto-login'); return true; }
    } else if (detection.loading) {
      if (attempt === 3 || attempt === 7) { page.goto(TENNIS_URL).catch(() => {}); }
      await sleep(5000);
    } else {
      await performLogin(page);
      await sleep(3000);
      if (await isLoggedIn(page)) { log('✅ Logged in — confirmed after login'); return true; }
    }
  }
  log('⚠️ Auto-login exhausted — please log in manually in the browser');
  for (let w = 0; w < 120; w++) {
    if (await isLoggedIn(page)) { log('✅ Manual login detected — resuming'); return true; }
    if (w % 12 === 0 && w > 0) log(`  Waiting for manual login... (${w * 5}s)`);
    await sleep(5000);
  }
  return false;
}

// ─── Location (copied verbatim from four.mjs — proven working) ───────────────
async function isLocationBlocked(page) {
  return page.evaluate(() => {
    const t = (document.body?.innerText || '').toLowerCase();
    if (t.includes('trouble verifying your location') || t.includes('verifying your location') ||
        t.includes('you are in a location where betting is unavailable') ||
        t.includes('checking location') || t.includes('location where betting')) return true;
    for (const el of document.querySelectorAll('div, section, aside, [role="alert"], [role="banner"], span, p')) {
      const text = (el.textContent || '').trim().toLowerCase();
      const rect = el.getBoundingClientRect();
      if (rect.width < 200 || rect.height < 20 || rect.height > 120) continue;
      if (text.includes('trouble verifying') || text.includes('verifying your location') ||
          text.includes('required to bet') || text.includes('location where betting')) return true;
    }
    return false;
  }).catch(() => true);
}

async function clickRecheckLocation(page) {
  const bannerInfo = await page.evaluate(() => {
    for (const el of document.querySelectorAll('div, section, aside, a, [role="alert"], [role="banner"]')) {
      const text = (el.textContent || '').toLowerCase();
      if (!text.includes('location') && !text.includes('verifying')) continue;
      const rect = el.getBoundingClientRect();
      if (rect.height < 10 || rect.height > 200 || rect.width < 200) continue;
      if (rect.y < 0 || rect.y > 500) continue;
      return { x: rect.x, y: rect.y, w: rect.width, h: rect.height };
    }
    return null;
  }).catch(() => null);
  if (!bannerInfo) { log('  No location banner found'); return null; }
  const clickX = bannerInfo.x + bannerInfo.w - 30;
  const clickY = bannerInfo.y + bannerInfo.h / 2;
  log(`  Clicking banner at (${Math.round(clickX)}, ${Math.round(clickY)})`);
  await page.mouse.click(clickX, clickY);
  await sleep(2000);
  await page.mouse.click(bannerInfo.x + bannerInfo.w / 2, clickY);
  log('  Location recheck clicked');
  await sleep(8000);
  if (!page.url().includes('/live')) {
    try { await page.goto(TENNIS_URL, { waitUntil: 'domcontentloaded', timeout: 20000 }); } catch {}
    await sleep(5000);
  }
  return 'mouse';
}

async function ensureLocationVerified(page) {
  let attempt = 0;
  while (true) {
    if (!await isLocationBlocked(page)) return true;
    attempt++;
    const phase = ((attempt - 1) % 4) + 1;
    log(`⚠️ Location blocked (attempt ${attempt}, strategy ${phase}/4)`);
    if (attempt <= 3 || attempt % 5 === 0) await screenshot(page, `geo-blocked-${attempt}`);
    if (phase === 1) {
      const clicked = await clickRecheckLocation(page);
      if (!clicked) log('  No recheck element found');
      await sleep(5000);
    } else if (phase === 2) {
      log('  🔄 Hard reload...');
      try { await page.reload({ waitUntil: 'domcontentloaded', timeout: 30000 }); } catch {}
      await sleep(12000);
    } else if (phase === 3) {
      log('  🔄 Full re-navigation...');
      try { await page.goto('https://sportsbook.draftkings.com/', { waitUntil: 'domcontentloaded', timeout: 30000 }); } catch {}
      await sleep(8000);
      try { await page.goto(TENNIS_URL, { waitUntil: 'domcontentloaded', timeout: 30000 }); } catch {}
      await sleep(12000);
    } else {
      await clickRecheckLocation(page);
      await sleep(15000);
    }
  }
}

