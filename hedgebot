async function closeBetReceipt(page) {
  for (let i = 0; i < 4; i++) {
    const closed = await page.evaluate(() => {
      for (const el of document.querySelectorAll('button, [role="button"], a, span, div')) {
        const t = (el.textContent || '').trim().toLowerCase();
        if (t.length > 30) continue;
        const r = el.getBoundingClientRect();
        if (r.width === 0 || r.height === 0 || r.x < 500) continue;
        if (t === 'close' || t === 'done' || t === '×' || t === 'x' || t === 'ok' || t === 'got it') {
          el.click(); return t;
        }
      }
      return null;
    }).catch(() => null);
    if (closed) { await sleep(300); return; }
    await sleep(400);
  }
  await clearBetSlip(page);
}

// ─── Enter wager (proven React setter approach from four.mjs) ─────────────────
async function enterWager(page, amount) {
  await page.evaluate(() => window.scrollTo(0, 0)).catch(() => {});

  for (let attempt = 1; attempt <= 3; attempt++) {
    // Find any visible input on the right-side bet slip
    const inputPos = await page.evaluate(() => {
      for (const input of document.querySelectorAll('input')) {
        const r = input.getBoundingClientRect();
        if (r.width === 0 || r.height === 0 || r.width > 250 || r.x < 600) continue;
        return { x: r.x + r.width / 2, y: r.y + r.height / 2 };
      }
      return null;
    }).catch(() => null);

    if (!inputPos) {
      log(`  No wager input found (attempt ${attempt}/3)`);
      await sleep(600);
      continue;
    }

    // Click 3x to select all, then type
    await page.mouse.click(inputPos.x, inputPos.y, { clickCount: 3 });
    await sleep(50);
    await page.keyboard.press('Backspace');
    await page.keyboard.type(amount.toString(), { delay: 30 });

    // React setter to ensure value registers
    await page.evaluate(({ x, y, amt }) => {
      const el = document.elementFromPoint(x, y);
      if (!el || el.tagName !== 'INPUT') return;
      try {
        const setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
        setter.call(el, amt);
        el.dispatchEvent(new Event('input', { bubbles: true }));
        el.dispatchEvent(new Event('change', { bubbles: true }));
      } catch {}
    }, { x: inputPos.x, y: inputPos.y, amt: amount.toString() });
    await page.keyboard.press('Tab');
    await sleep(300);
    log(`  ✅ Wager set: $${amount}`);
    return true;
  }
  log('  ❌ Could not set wager');
  return false;
}

// ─── Place a single straight bet ──────────────────────────────────────────────
async function placeSingleBet(page, team1, team2, side, odds, buttonIdx) {
  log(`  → Clearing bet slip`);
  await clearBetSlip(page);
  await sleep(500);

  log(`  → Clicking ${side} @ ${odds} (button index ${buttonIdx})`);
  const clicked = await clickMLButton(page, team1, team2, buttonIdx);
  if (!clicked) {
    log(`  ❌ clickMLButton returned null for ${team1} vs ${team2} idx=${buttonIdx}`);
    await screenshot(page, 'click-fail');
    return false;
  }
  await sleep(1500);

  // Step 1: Expand collapsed bet slip drawer (DK hides it at the bottom)
  await page.evaluate(() => {
    for (const el of document.querySelectorAll('div, button, [role="button"], a, span')) {
      const t = (el.textContent || '').trim().toLowerCase();
      const r = el.getBoundingClientRect();
      if ((t.includes('bet slip') || t.includes('betslip')) && r.y > 500 && r.height < 80 && r.width > 200) {
        el.click(); return true;
      }
    }
    return false;
  }).catch(() => false);
  await sleep(1000);

  // Step 2: Remove suspended/closed picks
  for (let i = 0; i < 3; i++) {
    const removed = await page.evaluate(() => {
      for (const el of document.querySelectorAll('button, [role="button"], a')) {
        const t = (el.textContent || '').trim().toLowerCase();
        if (t.length < 80 && (t.includes('remove suspended') || t.includes('remove closed'))) {
          el.click(); return true;
        }
      }
      return false;
    }).catch(() => false);
    if (!removed) break;
    await sleep(500);
  }

  // Step 3: Accept odds change notices
  await page.evaluate(() => {
    for (const el of document.querySelectorAll('button, [role="button"]')) {
      const t = (el.textContent || '').trim().toLowerCase();
      if (t.includes('accept') || t.includes('got it')) { el.click(); return; }
    }
  }).catch(() => {});
  await sleep(300);

  // Step 4: Enter wager
  log(`  → Entering wager $${WAGER}`);
  await enterWager(page, WAGER);
  await sleep(500);

  // Step 5: Accept odds changes again after wager entry
  await page.evaluate(() => {
    for (const el of document.querySelectorAll('button, [role="button"]')) {
      const t = (el.textContent || '').trim().toLowerCase();
      if (t.includes('accept') || t.includes('got it')) { el.click(); return; }
    }
  }).catch(() => {});
  await sleep(300);

  // Step 6: Scroll to top so bet slip is fully visible
  await page.evaluate(() => window.scrollTo(0, 0)).catch(() => {});
  await sleep(300);

  // Step 7: Click Place Bet
  log(`  → Clicking Place Bet`);
  const placed = await page.evaluate(() => {
    for (const el of document.querySelectorAll('button, [role="button"]')) {
      const t = (el.textContent || '').trim().toLowerCase();
      const r = el.getBoundingClientRect();
      if (r.width === 0 || r.height === 0 || r.x < 600) continue;
      if (t === 'place bet' || t.startsWith('place bet') || t.includes('accept & place')) {
        el.scrollIntoView({ block: 'center', behavior: 'instant' });
        el.click();
        return t.slice(0, 40);
      }
    }
    // Log all visible right-side buttons for debugging
    const btns = [];
    for (const el of document.querySelectorAll('button, [role="button"]')) {
      const r = el.getBoundingClientRect();
      if (r.x > 600 && r.width > 0 && r.height > 0) btns.push((el.textContent || '').trim().slice(0, 30));
    }
    return { notFound: true, btns };
  }).catch(() => null);

  if (!placed || (placed && placed.notFound)) {
    const btns = placed?.btns || [];
    log(`  ❌ Place Bet button not found. Right-side buttons: [${btns.join(' | ')}]`);
    await screenshot(page, 'no-place-btn');
    await clearBetSlip(page);
    return false;
  }

  await sleep(2500);
  await closeBetReceipt(page);
  logBet(`✅ Placed $${WAGER} on ${side} @ ${odds} — ${team1} vs ${team2}`);
  return true;
}

// ─── Main ─────────────────────────────────────────────────────────────────────
async function main() {
  log('═══════════════════════════════════════════════');
  log('DraftKings Live Hedge Bot — TENNIS');
  log(`Wager: $${WAGER} | Scan: every ${SCAN_INTERVAL / 1000}s`);
  log('═══════════════════════════════════════════════\n');

  loadState();
  log(`Restored ${Object.keys(tracked).length} tracked game(s) from state`);

  const { page } = await connectBrowser();

  // Navigate to tennis live page
  log('Navigating to tennis live page...');
  try { await page.goto(TENNIS_URL, { waitUntil: 'domcontentloaded', timeout: 30000 }); } catch {}
  await sleep(4000);

  // Ensure logged in and location verified before starting
  await ensureReady(page);
  log('✅ Ready — starting bet cycles');

  let cycle = 0;
  while (true) {
    cycle++;
    log(`\n─── Cycle ${cycle} ─────────────────────────────────`);

    try {
      // Ensure on tennis page — ensureReady already ran at startup or after each bet nav
      if (!page.url().includes('tennis')) {
        log('Not on tennis page — navigating + re-verifying...');
        try { await page.goto(TENNIS_URL, { waitUntil: 'domcontentloaded', timeout: 20000 }); } catch {}
        await sleep(3000);
        await ensureReady(page);
      }

      const games = await scrapeTennisGames(page);
      log(`Scraped ${games.length} live tennis game(s)`);
      if (games.length === 0) {
        // Debug: log raw DOM info
        const info = await page.evaluate(() => ({
          url: location.href,
          bodyLen: (document.body?.innerText || '').length,
          blockCount: document.querySelectorAll('.cb-market__template').length,
        })).catch(() => ({}));
        log(`  [debug] url=${info.url} bodyLen=${info.bodyLen} blocks=${info.blockCount}`);
      }

      // Process every game from the current scrape.
      // After each bet we navigate back to tennis — the game block is re-rendered
      // in the fresh DOM so clickMLButton finds it without a separate re-scrape.
      for (const game of games) {
        const { team1, team2, ml1, ml2, allOddsDebug } = game;
        const key = [team1, team2].sort().join('|').toLowerCase();
        const o1 = parseOdds(ml1.odds);
        const o2 = parseOdds(ml2.odds);
        const p1 = !isNaN(o1) && o1 > 0;
        const p2 = !isNaN(o2) && o2 > 0;

        log(`  ${team1}(${ml1.odds}) vs ${team2}(${ml2.odds}) | debug: ${allOddsDebug}`);

        // ── Not yet tracked → place initial bet ─────────────────────────────
        if (!tracked[key]) {
          if (!p1 && !p2) { log(`    No + odds — skip`); continue; }

          let side, oddsStr, idx;
          if (p1 && p2) {
            if (o1 <= o2) { side = team1; oddsStr = ml1.odds; idx = ml1.idx; }
            else          { side = team2; oddsStr = ml2.odds; idx = ml2.idx; }
          } else if (p1) { side = team1; oddsStr = ml1.odds; idx = ml1.idx; }
          else           { side = team2; oddsStr = ml2.odds; idx = ml2.idx; }

          logBet(`NEW: ${team1} vs ${team2} — betting ${side} @ ${oddsStr}`);
          const ok = await placeSingleBet(page, team1, team2, side, oddsStr, idx);

          if (ok) {
            tracked[key] = {
              team1, team2,
              betA: { side, odds: oddsStr, ts: new Date().toISOString() },
              betB: null, hedged: false,
            };
            saveState();
            logEntry({ ts: new Date().toISOString(), event: 'initial_bet', game: key, side, odds: oddsStr, wager: WAGER });
          }

          // Navigate back to tennis after each bet so DOM is ready for next game
          try { await page.goto(TENNIS_URL, { waitUntil: 'domcontentloaded', timeout: 20000 }); } catch {}
          await sleep(3000);
          // No break — continue to next game
          continue;
        }

        // ── Already tracked — check for hedge opportunity ───────────────────
        const state = tracked[key];
        if (state.hedged) { log(`    Already hedged ✅`); continue; }

        const betASideIsTeam1 = state.betA.side === team1;
        const oppOdds    = betASideIsTeam1 ? o2 : o1;
        const oppSide    = betASideIsTeam1 ? team2 : team1;
        const oppOddsStr = betASideIsTeam1 ? ml2.odds : ml1.odds;
        const oppIdx     = betASideIsTeam1 ? ml2.idx : ml1.idx;

        if (!isNaN(oppOdds) && oppOdds > 0) {
          logBet(`HEDGE: ${oppSide} @ ${oppOddsStr} — betting now!`);
          const ok = await placeSingleBet(page, team1, team2, oppSide, oppOddsStr, oppIdx);

          if (ok) {
            state.betB = { side: oppSide, odds: oppOddsStr, ts: new Date().toISOString() };
            state.hedged = true;
            saveState();
            logEntry({ ts: new Date().toISOString(), event: 'hedge_bet', game: key, side: oppSide, odds: oppOddsStr, wager: WAGER });
            logBet(`✅ FULLY HEDGED: ${team1} vs ${team2} — profit locked in!`);
          }

          // Navigate back and continue to next game
          try { await page.goto(TENNIS_URL, { waitUntil: 'domcontentloaded', timeout: 20000 }); } catch {}
          await sleep(3000);
          continue;
        } else {
          log(`    Monitoring: waiting for ${oppSide} to go + (currently ${oppOddsStr})`);
        }
      }

      // Clean up finished games (no longer in DOM)
      const live = new Set(games.map(g => [g.team1, g.team2].sort().join('|').toLowerCase()));
      for (const key of Object.keys(tracked)) {
        if (!live.has(key)) {
          const s = tracked[key];
          const outcome = s.hedged ? 'hedged' : 'unhedged';
          log(`  Game ended (${outcome}): ${s.team1} vs ${s.team2}`);
          logEntry({ ts: new Date().toISOString(), event: `game_ended_${outcome}`, game: key, betA: s.betA, betB: s.betB });
          delete tracked[key];
          saveState();
        }
      }

    } catch (e) {
      log(`Cycle error: ${e.message}\n${e.stack?.split('\n')[1] || ''}`);
      await screenshot(page, 'error');
    }

    log(`⏳ Sleeping ${SCAN_INTERVAL / 1000}s...`);
    await sleep(SCAN_INTERVAL);
  }
}

main().catch(e => { log(`Fatal: ${e.message}`); process.exit(1); });
