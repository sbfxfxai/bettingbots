// Parse O/U picks from a game's allOdds — "discount" = odds >= -105 (better than standard -110)
function pickOverUnderValue(game) {
  const picks = [];
  const allOdds = game.allOdds || [];
  for (let i = 0; i < allOdds.length; i++) {
    const parts = allOdds[i].split('|');
    const value = parts[0] || '';
    const points = parts[1] || '';
    const title = (parts[2] || '').toUpperCase();
    const isOU = title === 'O' || title === 'U' ||
                 points.toUpperCase().startsWith('O ') || points.toUpperCase().startsWith('U ');
    if (!isOU) continue;
    const oddsNum = parseAmericanOdds(value);
    if (isNaN(oddsNum)) continue;
    if (oddsNum < -105) continue; // only "discounted" lines
    const side = (title === 'O' || points.toUpperCase().startsWith('O')) ? 'OVER' : 'UNDER';
    picks.push({
      team: side, label: `${side} ${points} @ ${value}`,
      odds: value, buttonIndex: i,
      team1: game.team1, team2: game.team2,
      points, score: `${game.score1}-${game.score2}`,
      period: game.period, clock: game.clock,
    });
  }
  return picks;
}

// Pick positive spread bets — only + spreads (underdog getting points)
function pickPositiveSpread(game) {
  const picks = [];
  const allOdds = game.allOdds || [];
  for (let i = 0; i < allOdds.length; i++) {
    const parts = allOdds[i].split('|');
    const value = parts[0] || '';
    const points = parts[1] || '';
    const title = (parts[2] || '').toUpperCase();
    if (title === 'O' || title === 'U' ||
        points.toUpperCase().startsWith('O ') || points.toUpperCase().startsWith('U ')) continue;
    if (!points || !points.startsWith('+')) continue;
    const spreadVal = parseFloat(points.replace('+', ''));
    if (isNaN(spreadVal) || spreadVal <= 0) continue;
    picks.push({
      team: `+${spreadVal}`, label: `${points} @ ${value}`,
      odds: value, buttonIndex: i,
      team1: game.team1, team2: game.team2,
      points, spread: spreadVal,
      score: `${game.score1}-${game.score2}`,
      period: game.period, clock: game.clock,
    });
  }
  return picks;
}

// Generic: collect picks across all visible sport tabs
// pickFn(game, sport) → array of pick objects for that game
async function collectAllPicks(page, visibleTabs, pickFn) {
  const allPicks = [];
  const addedGames = new Set();
  const SKIP = new Set(['SOCCER']);
  for (const tab of visibleTabs) {
    if (SKIP.has(tab.text.toUpperCase())) continue;
    const tabClicked = await clickVisibleSportTab(page, tab.text, tab);
    if (!tabClicked) continue;
    await expandAllSections(page);
    const games = await scrapeGames(page);
    for (const game of games) {
      const key = [game.team1, game.team2].sort().join('|').toLowerCase();
      if (addedGames.has(key)) continue;
      addedGames.add(key);
      const picks = pickFn(game, tab.text);
      for (const p of picks) { p.sport = tab.text; p.sportTab = tab; }
      allPicks.push(...picks);
    }
  }
  return allPicks;
}

// Like clickMoneyline but lenient — clicks by button index without requiring odds text match
// Handles live odds shifts between collection and placement
async function clickOddsButton(page, pick) {
  return page.evaluate((target, sel) => {
    const norm = s => (s || '').replace(/\s+/g, ' ').trim();
    const blocks = Array.from(document.querySelectorAll(sel.gameBlock))
      .filter(b => b.querySelector(sel.gameBlockFilter));
    const matchBlock = blocks.find(block => {
      const teams = Array.from(block.querySelectorAll(sel.teamName)).map(el => norm(el.textContent));
      return teams.includes(norm(target.team1)) && teams.includes(norm(target.team2));
    });
    if (!matchBlock) return null;
    matchBlock.scrollIntoView({ block: 'center', behavior: 'instant' });
    const buttons = Array.from(matchBlock.querySelectorAll(sel.oddsButton));
    // Click by stored index (same market position even if odds shifted)
    if (target.buttonIndex >= 0 && target.buttonIndex < buttons.length) {
      const btn = buttons[target.buttonIndex];
      btn.click();
      const oddsEl = btn.querySelector(sel.oddsValue) || btn;
      return 'idx:' + norm(oddsEl.textContent);
    }
    // Fallback: try text match
    for (const btn of buttons) {
      const oddsEl = btn.querySelector(sel.oddsValue) || btn;
      if (norm(oddsEl.textContent) === norm(target.odds)) { btn.click(); return 'text_match'; }
    }
    return null;
  }, pick, SEL);
}

// Scroll through virtualized list until a game block with both team names is in the DOM
async function scrollToGame(page, team1, team2) {
  await page.evaluate(() => window.scrollTo(0, 0)).catch(() => {});
  await new Promise(r => setTimeout(r, 200));
  const norm = s => (s || '').replace(/\s+/g, ' ').trim();
  for (let pass = 0; pass < 30; pass++) {
    const found = await page.evaluate((t1, t2, sel) => {
      const n = s => (s || '').replace(/\s+/g, ' ').trim();
      for (const block of document.querySelectorAll(sel.gameBlock)) {
        const teams = Array.from(block.querySelectorAll(sel.teamName)).map(el => n(el.textContent));
        if (teams.includes(n(t1)) && teams.includes(n(t2))) {
          block.scrollIntoView({ block: 'center', behavior: 'instant' });
          return true;
        }
      }
      return false;
    }, team1, team2, SEL).catch(() => false);
    if (found) return true;
    const atBottom = await page.evaluate(() => {
      if (!document.body) return true;
      window.scrollBy(0, window.innerHeight * 0.8);
      return window.scrollY + window.innerHeight >= document.body.scrollHeight - 50;
    }).catch(() => true);
    await new Promise(r => setTimeout(r, 250));
    if (atBottom) break;
  }
  return false;
}

// Place a single parlay from an array of pre-collected picks
async function placeParlayFromPicks(page, picks, wager, label) {
  await clearBetSlip(page);
  await new Promise(r => setTimeout(r, 500));

  // Group by sport so we navigate tabs efficiently
  const bySport = {};
  for (const p of picks) {
    const s = p.sport || 'UNKNOWN';
    if (!bySport[s]) bySport[s] = [];
    bySport[s].push(p);
  }

  let addedCount = 0;
  for (const [sport, sportPicks] of Object.entries(bySport)) {
    const tab = sportPicks[0].sportTab;
    if (tab) await clickVisibleSportTab(page, tab.text, tab);
    await expandAllSections(page);
    for (const pick of sportPicks) {
      // Scroll virtualized list to bring this game into the DOM
      const scrolled = await scrollToGame(page, pick.team1, pick.team2);
      if (!scrolled) {
        log(`    ❌ Could not find game block: ${pick.team1} vs ${pick.team2} (not in DOM after scrolling)`);
        continue;
      }
      await new Promise(r => setTimeout(r, 300));
      
      // Retry logic with exponential backoff
      let clicked = null;
      for (let attempt = 0; attempt < 3; attempt++) {
        clicked = await clickOddsButton(page, pick);
        if (clicked) break;
        if (attempt < 2) {
          const delay = 500 * Math.pow(2, attempt); // 500ms, 1000ms, 2000ms
          log(`    ⏳ Retry ${attempt + 1}/3 for ${pick.team1} vs ${pick.team2} (waiting ${delay}ms)`);
          await new Promise(r => setTimeout(r, delay));
        }
      }
      
      if (clicked) {
        addedCount++;
        log(`    Added: ${pick.team1} vs ${pick.team2} → ${pick.label || pick.team} @ ${pick.odds} (${clicked})`);
        await new Promise(r => setTimeout(r, 1500)); // Increased from 800ms to 1500ms
      } else {
        log(`    ❌ Could not click for ${pick.team1} vs ${pick.team2} after 3 attempts`);
      }
    }
  }

  if (addedCount < 2) {
    log(`  Only ${addedCount} leg(s) — need ≥2, skipping`);
    await clearBetSlip(page);
    return false;
  }

  // Scroll page to top so bet slip panel is fully visible
  await page.evaluate(() => window.scrollTo(0, 0)).catch(() => {});
  await new Promise(r => setTimeout(r, 1500));

  // Verify actual bet slip leg count (the green circle number on "BET SLIP")
  const actualLegs = await page.evaluate(() => {
    // DK shows leg count in a badge/circle near "BET SLIP" text
    for (const el of document.querySelectorAll('span, div, [class*="badge"], [class*="count"], [class*="indicator"]')) {
      const t = (el.textContent || '').trim();
      const rect = el.getBoundingClientRect();
      if (/^\d+$/.test(t) && rect.width > 0 && rect.width < 50 && rect.height < 50 && rect.x > 700) {
        const n = parseInt(t, 10);
        if (n >= 1 && n <= 30) return n;
      }
    }
    return -1;
  }).catch(() => -1);
  log(`  Bet slip shows ${actualLegs} leg(s) (expected ${addedCount})`);

  // If leg count doesn't match, wait and retry verification (DraftKings may be slow to update)
  if (actualLegs >= 0 && actualLegs !== addedCount) {
    log(`  ⏳ Leg count mismatch, waiting for DraftKings to update...`);
    await new Promise(r => setTimeout(r, 3000));
    const retryLegs = await page.evaluate(() => {
      for (const el of document.querySelectorAll('span, div, [class*="badge"], [class*="count"], [class*="indicator"]')) {
        const t = (el.textContent || '').trim();
        const rect = el.getBoundingClientRect();
        if (/^\d+$/.test(t) && rect.width > 0 && rect.width < 50 && rect.height < 50 && rect.x > 700) {
          const n = parseInt(t, 10);
          if (n >= 1 && n <= 30) return n;
        }
      }
      return -1;
    }).catch(() => -1);
    log(`  Retry verification: ${retryLegs} leg(s)`);
    if (retryLegs >= 0) actualLegs = retryLegs;
  }

  if (actualLegs >= 0 && actualLegs < 2) {
    log(`  ⚠️ Bet slip has <2 actual legs — skipping placement`);
    await clearBetSlip(page);
    return false;
  }

  // Wait for DraftKings to update bet slip with parlay section
  log(`  ⏳ Waiting for parlay section to load...`);
  await new Promise(r => setTimeout(r, 5000));

  // Debug: Check what's in the bet slip
  const betSlipContent = await page.evaluate(() => {
    const slip = document.querySelector('[class*="betslip"], [class*="bet-slip"], [class*="slip"], [class*="BetSlip"], [class*="Slip"]');
    if (!slip) return 'No bet slip found';
    return slip.textContent.slice(0, 500);
  }).catch(() => 'Error reading bet slip');
  log(`  Bet slip content preview: "${betSlipContent.slice(0, 200)}"`);

  // Enter wager amount before placing bet
  const wagerSet = await enterWager(page, wager);
  if (!wagerSet) {
    log(`  ⚠️ Could not set wager amount`);
    await clearBetSlip(page);
    return false;
  }

  const placed = await clickPlaceBet(page);
  if (placed) {
    logBet(`🎯 ${label}: ${addedCount}-leg parlay placed @ $${wager}`);
    const entry = {
      ts: new Date().toISOString(), type: label, legs: addedCount, wager,
      picks: picks.map(p => `${p.team1} vs ${p.team2}: ${p.label || p.team} ${p.odds}`),
    };
    try { appendFileSync(PARLAY_LOG, JSON.stringify(entry) + '\n'); } catch {}
    await new Promise(r => setTimeout(r, 2000));
    await closeBetReceipt(page);
  } else {
    log(`  ⚠️ Could not place ${label} parlay`);
    await screenshot(page, `${label.toLowerCase().replace(/\s+/g, '-')}-failed`);
  }
  await clearBetSlip(page);
  return !!placed;
}

// ─── Structured Parlays: 2, 3, 5, 8 leg ML parlays ─────────────────────────
async function runStructuredParlays(page, visibleTabs) {
  log('\n═══ Structured Parlays Scan ═══════════════════════');

  const mlPickFn = (game, sport) => {
    const w = pickWinner(game, sport);
    if (!w) return [];
    w.label = `ML ${w.team}`;
    return [w];
  };

  const allPicks = await collectAllPicks(page, visibleTabs, mlPickFn);
  log(`Collected ${allPicks.length} ML picks for structured parlays`);
  if (allPicks.length < 2) { log('Not enough picks'); return; }

  for (const legCount of STRUCTURED_LEG_COUNTS) {
    if (allPicks.length < legCount) {
      log(`Not enough picks (${allPicks.length}) for ${legCount}-leg — skipping`);
      continue;
    }
    const groups = [];
    for (let i = 0; i + legCount <= allPicks.length; i += legCount) {
      groups.push(allPicks.slice(i, i + legCount));
    }
    log(`\n─── ${legCount}-Leg Structured: ${groups.length} parlay(s) ───`);

    for (let g = 0; g < groups.length; g++) {
      log(`  Parlay ${g + 1}/${groups.length}: ${groups[g].map(p => p.team).join(' + ')}`);
      try {
        await page.goto('https://sportsbook.draftkings.com/live?category=live-in-game&subcategory=basketball',
          { waitUntil: 'domcontentloaded', timeout: 30000 });
      } catch {}
      await new Promise(r => setTimeout(r, 3000));
      await placeParlayFromPicks(page, groups[g], PARLAY_WAGER, `STRUCTURED-${legCount}L`);
      await new Promise(r => setTimeout(r, 1000));
    }
  }
  log('═══ Structured Parlays Complete ═══════════════════');
}

// ─── O/U Value Scan: max-leg parlay on discounted O/U ────────────────────────
async function runOUValueScan(page, visibleTabs) {
  log('\n═══ O/U Value Scan ═══════════════════════════════');
  const allPicks = await collectAllPicks(page, visibleTabs, (game) => pickOverUnderValue(game));
  log(`Collected ${allPicks.length} discounted O/U picks`);
  if (allPicks.length < 2) { log('Not enough O/U value picks'); return; }

  const picks = allPicks.slice(0, MAX_LEGS);
  try {
    await page.goto('https://sportsbook.draftkings.com/live?category=live-in-game&subcategory=basketball',
      { waitUntil: 'domcontentloaded', timeout: 30000 });
  } catch {}
  await new Promise(r => setTimeout(r, 3000));
  await placeParlayFromPicks(page, picks, PARLAY_WAGER, 'OU-VALUE');
  log('═══ O/U Value Scan Complete ══════════════════════');
}

