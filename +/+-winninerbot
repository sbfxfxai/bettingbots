    }).catch(() => false);
    if (!removed) break;
    log(`Removed late suspended pick (pass ${i + 1})`);
    await new Promise(r => setTimeout(r, 500));
  }

  // Step 7: Final accept odds changes pass
  for (let i = 0; i < 3; i++) {
    if ((await acceptOddsChanges(page)) === 0) break;
    await new Promise(r => setTimeout(r, 800));
  }
  await new Promise(r => setTimeout(r, 500));

  // Step 8: Find and click Place Bet / Accept Change & Place Bet button
  const clicked = await page.evaluate(() => {
    let best = null; let bestScore = 0;
    const allButtons = [];
    for (const el of document.querySelectorAll('button, [role="button"], a, div, span')) {
      const text = (el.textContent || '').trim().toLowerCase();
      if (text.length > 100) continue;
      if (!text.includes('place bet') && !text.includes('place wager') &&
          !text.includes('accept & place') && !text.includes('accept change') &&
          !text.includes('place')) continue;
      let score = 1;
