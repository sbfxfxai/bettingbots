// ─── Main Loop ───────────────────────────────────────────────────────────────
async function main() {
  log('═══════════════════════════════════════════════');
  log('DraftKings Live O/U Parlay Bot');
  log('═══════════════════════════════════════════════');
  log(`Mode: O/U ONLY | Wager: $${PARLAY_WAGER} | Max legs: ${MAX_LEGS} | Interval: ${SCAN_INTERVAL / 1000}s`);
  log(`Sports: ${SPORTS.map(s => s.name).join(', ')}`);
  log('');

  const { browser, page } = await connectBrowser();
  log(`Page: ${page.url()}`);

  // Track GeoComply CORS blocks at runtime
  let corsBlocked = false;
  page.on('requestfailed', req => {
    const url = req.url();
    const reason = req.failure()?.errorText || '';
    if (url.includes('plc-gc.com') || url.includes('geocomply')) {
      log(`🚨 GeoComply CORS block detected: ${url} — ${reason}`);
      corsBlocked = true;
    }
  });

  let cycle = 0;
  const STRATEGIES = [
    { name: 'A: + closest to 100',  fn: pickOU },
    { name: 'B: - closest to 100',  fn: pickClosestNeg },
    { name: 'C: winning team ML',   fn: pickWinningTeamML },
  ];
  while (true) {
    cycle++;
    log(`\n─── Cycle ${cycle} ───────────────────────────────────`);
    corsBlocked = false; // reset each cycle

    try {
      // Step 0: Ensure we are on the LIVE page (SPA may drift after bet placement)
      const currentUrl = page.url();
      if (!currentUrl.includes('/live') || !currentUrl.includes('live-in-game')) {
        log(`⚠️ Not on live page (${currentUrl.slice(0, 80)}) — navigating back...`);
        try {
          await page.goto('https://sportsbook.draftkings.com/live?category=live-in-game&subcategory=basketball', { waitUntil: 'domcontentloaded', timeout: 30000 });
        } catch (navErr) {
          log(`Nav error: ${navErr.message.split('\n')[0]} — waiting...`);
        }
        await new Promise(r => setTimeout(r, 5000));
      }

      // Step 1: Open page & verify location FIRST
      const locationOk = await verifyLocation(page);
      if (!locationOk) {
        log('Skipping cycle — location not verified');
        continue;
      }

      // If CORS was blocked during location verify, reload to retry
      if (corsBlocked) {
        log('⚠️ GeoComply CORS blocked — reloading page to retry location...');
        try { await page.reload({ waitUntil: 'domcontentloaded', timeout: 60000 }); } catch {}
        await new Promise(r => setTimeout(r, 8000));
        corsBlocked = false;
        const retryLoc = await verifyLocation(page);
        if (!retryLoc) {
          log('❌ Location still failing after reload — skipping cycle');
          continue;
        }
      }

      // Step 1b: ENSURE LOGIN before scanning
      const loggedIn = await ensureLoggedIn(page);
      if (!loggedIn) {
        log('⚠️ Could not log in — retrying cycle');
        continue;
      }

      // Step 1c: Check balance — need at least $0.10 to place a bet
      const balance = await getBalance(page);
      if (balance !== null) {
        log(`💰 Balance: $${balance.toFixed(2)}`);
        if (balance < 0.10) {
          log(`⚠️ Balance too low ($${balance.toFixed(2)}) — money tied up in positions, skipping cycle`);
          continue;
        }
      }

      // Step 2: Wait for sport tabs to render (SPA loads header first, content later)
      let visibleTabs = await getVisibleSportTabs(page);
      if (visibleTabs.length === 0) {
        log('Waiting for sport tabs to render...');
        // Navigate directly to live page with subcategory to force content load
        try {
          await page.goto('https://sportsbook.draftkings.com/live?category=live-in-game&subcategory=basketball',
            { waitUntil: 'domcontentloaded', timeout: 15000 });
        } catch {}
        await new Promise(r => setTimeout(r, 3000));
        // Poll for sport tabs up to 15s
        for (let w = 0; w < 15; w++) {
          await new Promise(r => setTimeout(r, 1000));
          visibleTabs = await getVisibleSportTabs(page).catch(() => []);
          if (visibleTabs.length > 0) break;
        }
      }

      if (visibleTabs.length === 0) {
        log('⚠️ No sport tabs after waiting — reloading page...');
        try { await page.reload({ waitUntil: 'domcontentloaded', timeout: 30000 }); } catch {}
        await new Promise(r => setTimeout(r, 5000));
        continue;
      }

      // Hard gate: never start scanning unless location is currently verified
      await ensureLocationVerified(page);
      log('✅ Location re-verified before scan');

      let locationLostDuringScan = false;

      let orderedTabs = [...visibleTabs];
      const bIndex = orderedTabs.findIndex(t => t.text.toUpperCase() === 'BASKETBALL');
      if (bIndex > 0) {
        orderedTabs = [orderedTabs[bIndex], ...orderedTabs.slice(0, bIndex), ...orderedTabs.slice(bIndex + 1)];
      }
      log(`Visible sport tabs (scan order): ${orderedTabs.map(t => t.text).join(', ')}`);

      // Only scan these sports
      const ALLOW_TABS = new Set(['BASKETBALL', 'NBA', 'BASEBALL', 'MLB', 'FOOTBALL', 'NFL', 'HOCKEY', 'NHL', 'VOLLEYBALL']);

      // Pick strategy rotates every cycle: A → B → C → A → …
      const strategy = STRATEGIES[(cycle - 1) % 3];
      log(`Strategy: ${strategy.name}`);

      // Step 3: Clear slip, scan all sports, accumulate up to 20 legs, submit ONE parlay
      await clearBetSlip(page);
      await new Promise(r => setTimeout(r, 500));

      const allPicks = [];
      const addedGames = new Set();

      for (const tab of orderedTabs) {
        if (allPicks.length >= MAX_LEGS) break;

        if (!ALLOW_TABS.has(tab.text.toUpperCase())) {
          log(`Skipping ${tab.text}`);
          continue;
        }

        if (await isLocationBlocked(page)) {
          log('⚠️ Location blocked — stopping scan');
          locationLostDuringScan = true;
          break;
        }

        log(`Scanning ${tab.text}...`);
        const tabClicked = await clickVisibleSportTab(page, tab.text, tab);
        if (!tabClicked) {
          log(`  Could not click tab: ${tab.text}`);
          continue;
        }

        const games = await scrapeGames(page);
        log(`  ${games.length} live game(s)`);

        for (const game of games) {
          if (allPicks.length >= MAX_LEGS) break;
          const gameKey = [game.team1, game.team2].sort().join('|').toLowerCase();
          if (addedGames.has(gameKey)) continue;

          const pick = strategy.fn(game, tab.text);
          if (!pick) continue;

          log(`  🖱️ ${pick.team} ${pick.points} @ ${pick.odds} — ${game.team1} vs ${game.team2} [${game.league || '?'}]`);
          const clicked = await clickMoneyline(page, pick);
          if (clicked) {
            logBet(`  Added: ${pick.team} ${pick.points} @ ${pick.odds} [line=${pick.totalLine}]`);
            allPicks.push(pick);
            addedGames.add(gameKey);
            await new Promise(r => setTimeout(r, 300));
          } else {
            log(`  ❌ Could not click O/U for ${game.team1} vs ${game.team2}`);
          }
        }
      }

      if (locationLostDuringScan) {
        await clearBetSlip(page);
        continue;
      }

      log(`\nTotal legs: ${allPicks.length}`);

      if (allPicks.length === 0) {
        log('No + O/U picks found across all sports — skipping');
        await clearBetSlip(page);
        continue;
      }

      // Switch to Parlay tab only when 2+ legs; single bet stays as-is
      if (allPicks.length >= 2) {
        await switchToParlayTab(page);
        await new Promise(r => setTimeout(r, 500));
      }

      // Enter wager and place
      await enterWager(page, PARLAY_WAGER);
      await new Promise(r => setTimeout(r, 300));

      // Scroll to top, then place bet
      await page.evaluate(() => window.scrollTo(0, 0)).catch(() => {});
      await new Promise(r => setTimeout(r, 200));

      const placed = await clickPlaceBet(page);
      if (!placed) {
        log('⚠️ Could not place bet — waiting 10s');
        await screenshot(page, 'no-place-btn');
        await clearBetSlip(page);
        await new Promise(r => setTimeout(r, 10000));
        continue;
      }

      const betType = allPicks.length === 1 ? 'SINGLE' : `${allPicks.length}-leg PARLAY`;
      logBet(`🎯 PLACED ${betType} O/U @ $${PARLAY_WAGER}!`);
      await new Promise(r => setTimeout(r, 1500));

      const entry = {
        ts: new Date().toISOString(),
        type: allPicks.length === 1 ? 'O/U-SINGLE' : 'O/U-PARLAY',
        legs: allPicks.length,
        wager: PARLAY_WAGER,
        picks: allPicks.map(p => `${p.label || p.team} (${p.team1} vs ${p.team2})`),
      };
      try { appendFileSync(PARLAY_LOG, JSON.stringify(entry) + '\n'); } catch {}
      logBet(`Logged ${entry.legs} legs`);

      let confirmed = false;
      for (let ci = 0; ci < 5 && !confirmed; ci++) {
        confirmed = await page.evaluate(() => {
          const bodyText = (document.body?.innerText || '').toLowerCase();
          return bodyText.includes('bet placed') || bodyText.includes('bet confirmed') ||
                 bodyText.includes('bet receipt') || bodyText.includes('your bet') ||
                 bodyText.includes('receipt') || bodyText.includes('successfully placed') ||
                 bodyText.includes('wager placed');
        }).catch(() => false);
        if (!confirmed) await new Promise(r => setTimeout(r, 400));
      }
      logBet(confirmed ? '✅ Bet confirmed!' : '⚠️ Confirmation not detected — may still have placed');

      await closeBetReceipt(page);
      try {
        await page.goto('https://sportsbook.draftkings.com/live?category=live-in-game&subcategory=basketball',
          { waitUntil: 'domcontentloaded', timeout: 30000 });
      } catch {}
      await new Promise(r => setTimeout(r, 2000));
      await clearBetSlip(page);

    } catch (e) {
      log(`Cycle error: ${e.message}`);
      await screenshot(page, 'error').catch(() => {});
    }

    // ─── 30-min Scans: DISABLED (O/U-only mode) ─────────────────────────────
    // Structured/ML/Spread scans are disabled while running O/U-only strategy.
    // Code preserved for later re-enablement.
    // if (now - lastStructuredRun >= STRUCTURED_INTERVAL) { ... }

    // Wait before next cycle
    log(`⏳ Sleeping ${SCAN_INTERVAL / 1000}s until next O/U scan...`);
    await new Promise(r => setTimeout(r, SCAN_INTERVAL));
  }
}

main().catch(e => { log(`Fatal: ${e.message}`); process.exit(1); });
