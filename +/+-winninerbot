async function getVisibleSportTabs(page) {
  return page.evaluate(() => {
    const known = new Set(['SOCCER', 'TENNIS', 'TABLE TENNIS', 'BASKETBALL', 'BASEBALL', 'HOCKEY', 'NHL', 'CRICKET', 'HANDBALL', 'VOLLEYBALL', 'BADMINTON']);
    const tabs = [];
    for (const el of document.querySelectorAll('a, button, [role="tab"], span, div')) {
      const text = (el.textContent || '').trim().toUpperCase();
      const rect = el.getBoundingClientRect();
      if (!known.has(text)) continue;
      if (rect.width === 0 || rect.height === 0) continue;
      if (rect.y > 200 || rect.height > 60 || rect.width > 250 || rect.width < 30) continue;
      tabs.push({ text, x: rect.x, y: rect.y, width: rect.width, height: rect.height });
    }
    // Sort left→right, dedup by normalized name (NHL=HOCKEY)
    const norm = t => t === 'NHL' ? 'HOCKEY' : t;
    const seen = new Set();
    const deduped = [];
    for (const tab of tabs.sort((a, b) => a.x - b.x)) {
      const key = norm(tab.text);
      if (seen.has(key)) continue;
      seen.add(key);
      deduped.push(tab);
    }
    return deduped;
  });
}

