async function enterWager(page, amount) {
  await page.evaluate(() => window.scrollTo(0, 0)).catch(() => {});

  for (let attempt = 1; attempt <= 3; attempt++) {
    // Scroll bet slip to bottom to reveal parlay section
    await page.evaluate(() => {
      for (const el of document.querySelectorAll('[class*="betslip"], [class*="bet-slip"], [class*="slip"], [class*="BetSlip"], [class*="Slip"]')) {
        if (el.scrollHeight > el.clientHeight) el.scrollTop = el.scrollHeight;
      }
    }).catch(() => {});
    await new Promise(r => setTimeout(r, 300));

    // ONLY find the parlay input — match "X Pick Parlay" text, never fall back to singles
    const parlayInput = await page.evaluate(() => {
      // Find "X Pick Parlay" text element
      for (const el of document.querySelectorAll('div, span, p, li, a, h1, h2, h3, h4, h5, h6')) {
        const text = (el.textContent || '').trim();
        if (!/\d+\s*[-–]?\s*pick\s*parlay/i.test(text)) continue;
        if (text.length > 120) continue;
        const rect = el.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) continue;
        const parlayY = rect.y + rect.height / 2;

        // Find the input nearest to this parlay text
        let best = null, bestDist = 999;
        for (const input of document.querySelectorAll('input')) {
          const ir = input.getBoundingClientRect();
          if (ir.width === 0 || ir.height === 0 || ir.width > 250) continue;
          const dist = Math.abs(ir.y + ir.height / 2 - parlayY);
          if (dist < bestDist) { bestDist = dist; best = { x: ir.x + ir.width / 2, y: ir.y + ir.height / 2, dist }; }
        }
        if (best && best.dist < 120) {
          return { found: true, x: best.x, y: best.y, text: text.slice(0, 50) };
        }
      }
      return { found: false };
    }).catch(() => ({ found: false }));

    if (!parlayInput.found) {
      log(`  No parlay input found (attempt ${attempt}/3)`);
      await new Promise(r => setTimeout(r, 500));
      continue;
    }

    log(`  Parlay input: "${parlayInput.text}" at (${Math.round(parlayInput.x)},${Math.round(parlayInput.y)})`);

    // Click, clear, type amount — fast
    await page.mouse.click(parlayInput.x, parlayInput.y, { clickCount: 3 });
    await new Promise(r => setTimeout(r, 50));
    await page.keyboard.press('Backspace');
    await page.keyboard.type(amount.toString(), { delay: 30 });

    // Also force via React setter
    await page.evaluate(({ x, y, amt }) => {
      const el = document.elementFromPoint(x, y);
      if (!el || el.tagName !== 'INPUT') return;
      try {
        const setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
        setter.call(el, amt);
        el.dispatchEvent(new Event('input', { bubbles: true }));
        el.dispatchEvent(new Event('change', { bubbles: true }));
      } catch {}
    }, { x: parlayInput.x, y: parlayInput.y, amt: amount.toString() });
    await page.keyboard.press('Tab');
    await new Promise(r => setTimeout(r, 200));

    log(`  ✅ Parlay wager set: $${amount}`);
    return true;
  }
  log('❌ Could not find parlay wager input');
  return false;
}

