function parseAmericanOdds(str) {
  if (!str) return NaN;
  // Normalise Unicode minus (−, U+2212) and en-dash to ASCII minus
  const norm = str.replace(/[\u2212\u2013]/g, '-').trim();
  const n = parseInt(norm.replace(/[^\-\d]/g, ''), 10);
  return isNaN(n) ? NaN : n;
}

