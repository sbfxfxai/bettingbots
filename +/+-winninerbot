};

function parseClockToSeconds(clock) {
  if (!clock) return null;
  const m = String(clock).match(/(\d{1,2}):(\d{2})/);
  if (!m) return null;
  return parseInt(m[1], 10) * 60 + parseInt(m[2], 10);
}

// Estimate how far through the game we are (0.0 = start, 1.0 = end)
function estimateGameProgress(sport, period, clock) {
  const p = String(period || '').toLowerCase();
  const clockSec = parseClockToSeconds(clock);
  const sportKey = (sport || '').toUpperCase().replace(/\s+/g, '_');

  if (sportKey === 'BASKETBALL' || sportKey.includes('BASKET')) {
    // Quarters: 12 min each (NBA), or halves: 20 min each (college/Euro)
    let qNum = null;
    if (p.includes('1st') && p.includes('quarter')) qNum = 1;
    else if (p.includes('2nd') && p.includes('quarter')) qNum = 2;
    else if (p.includes('3rd') && p.includes('quarter')) qNum = 3;
    else if (p.includes('4th') && p.includes('quarter')) qNum = 4;
    else if (p.includes('ot') || p.includes('overtime')) return 0.95;
    else if (p.includes('half')) {
      // College/Euro: 2 halves × 20 min
      const halfNum = p.includes('1st') ? 1 : 2;
      const halfLen = 20 * 60;
      const remain = clockSec != null ? clockSec : halfLen / 2;
      const elapsed = ((halfNum - 1) * halfLen) + (halfLen - remain);
      return Math.min(0.99, Math.max(0.05, elapsed / (2 * halfLen)));
    }
    if (qNum == null) return 0.5;
    const qLen = 12 * 60;
    const remain = clockSec != null ? clockSec : qLen / 2;
    const elapsed = ((qNum - 1) * qLen) + (qLen - remain);
    return Math.min(0.99, Math.max(0.05, elapsed / (4 * qLen)));
  }

  if (sportKey === 'HOCKEY' || sportKey.includes('HOCK')) {
    let pNum = null;
    if (p.includes('1st')) pNum = 1;
    else if (p.includes('2nd')) pNum = 2;
    else if (p.includes('3rd')) pNum = 3;
    else if (p.includes('ot') || p.includes('overtime')) return 0.95;
    if (pNum == null) return 0.5;
    const pLen = 20 * 60;
    const remain = clockSec != null ? clockSec : pLen / 2;
    const elapsed = ((pNum - 1) * pLen) + (pLen - remain);
    return Math.min(0.99, Math.max(0.05, elapsed / (3 * pLen)));
  }

  if (sportKey === 'HANDBALL' || sportKey.includes('HAND')) {
    const halfNum = p.includes('2nd') ? 2 : 1;
    const halfLen = 30 * 60;
    const remain = clockSec != null ? clockSec : halfLen / 2;
    const elapsed = ((halfNum - 1) * halfLen) + (halfLen - remain);
    return Math.min(0.99, Math.max(0.05, elapsed / (2 * halfLen)));
  }

  if (sportKey === 'SOCCER' || sportKey.includes('SOCC') || sportKey.includes('FOOT')) {
    const halfNum = p.includes('2nd') ? 2 : 1;
    const halfLen = 45 * 60;
    const remain = clockSec != null ? clockSec : halfLen / 2;
    const elapsed = ((halfNum - 1) * halfLen) + (halfLen - remain);
    return Math.min(0.99, Math.max(0.05, elapsed / (2 * halfLen)));
  }

  if (sportKey === 'BASEBALL' || sportKey.includes('BASE')) {
    // Innings: top/bot 1st-9th
    let inning = 1;
    const im = p.match(/(\d+)/);
    if (im) inning = parseInt(im[1], 10);
    const isBot = p.includes('bot') || p.includes('bottom') || p.includes('mid');
    const halfInnings = ((inning - 1) * 2) + (isBot ? 1 : 0);
    return Math.min(0.99, Math.max(0.05, halfInnings / 18));
  }

  return 0.5; // Unknown sport — assume mid-game
}

// Calculate O/U edge: positive = OVER edge, negative = UNDER edge
// Returns { side: 'OVER'|'UNDER'|null, delta, projected, threshold }
function calculateOUEdge(sport, score1, score2, totalLine, period, clock) {
  const sportKey = (sport || '').toUpperCase().replace(/\s+/g, '_');
  const threshold = OU_THRESHOLDS[sportKey] || 0;
  const s1 = parseInt(score1 || '0', 10) || 0;
  const s2 = parseInt(score2 || '0', 10) || 0;
  const line = parseFloat(totalLine) || 0;
  if (line <= 0) return { side: null, delta: 0, projected: 0, threshold };

  const currentTotal = s1 + s2;
  const progress = estimateGameProgress(sport, period, clock);

  // Pace decay: scoring slows ~2% per quarter-equivalent (Alameda-Basora)
  const quarterEquiv = Math.max(1, Math.ceil(progress * 4));
  const paceDecayFactor = 1 - (0.02 * (quarterEquiv - 1));
  const remainingProgress = 1 - progress;
  const currentPace = progress > 0.05 ? currentTotal / progress : line;
  const projectedRemaining = currentPace * remainingProgress * paceDecayFactor;
  const projectedFinalTotal = currentTotal + projectedRemaining;
  const delta = projectedFinalTotal - line;

  // Q2 bonus for basketball (Alameda-Basora: Q2 totals most profitable, 10% ROI)
  const q2Bonus = (sportKey.includes('BASKET') && quarterEquiv === 2) ? 1.15 : 1.0;
  const adjustedDelta = delta * q2Bonus;

  // No threshold for set-based sports — always bet (use OVER as default)
  if (threshold === 0) {
    return {
      side: adjustedDelta >= 0 ? 'OVER' : 'UNDER',
      delta: adjustedDelta, projected: projectedFinalTotal, threshold,
    };
  }

  // Only bet when delta exceeds threshold (Banker: selective betting flips negative ROI to positive)
  if (adjustedDelta > threshold) {
    return { side: 'OVER', delta: adjustedDelta, projected: projectedFinalTotal, threshold };
  }
  if (adjustedDelta < -threshold) {
    return { side: 'UNDER', delta: adjustedDelta, projected: projectedFinalTotal, threshold };
  }
  return { side: null, delta: adjustedDelta, projected: projectedFinalTotal, threshold };
}

