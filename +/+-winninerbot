async function countOpenPositions(page) {
  try {
    // Navigate to My Bets page
    await page.goto('https://sportsbook.draftkings.com/mybets', { waitUntil: 'domcontentloaded', timeout: 30000 });
    await new Promise(r => setTimeout(r, 3000));

    // Click "Open" tab if present
    await page.evaluate(() => {
      for (const el of document.querySelectorAll('a, button, [role="tab"], span, div')) {
        const t = (el.textContent || '').trim().toLowerCase();
        if (t === 'open' || t === 'unsettled') {
          el.click();
          return true;
        }
      }
      return false;
    });
    await new Promise(r => setTimeout(r, 2000));

    // Count open bet cards/entries
    const result = await page.evaluate(() => {
      const body = document.body?.innerText || '';
      let count = 0;
      // Strategy 1: Look for bet card containers with wager/payout info
      for (const el of document.querySelectorAll('[class*="bet-card"], [class*="betCard"], [class*="BetCard"], [class*="bet-slip-card"], [class*="mybet"]')) {
        const rect = el.getBoundingClientRect();
        if (rect.height > 30 && rect.width > 100) count++;
      }
      // Strategy 2: If no cards found, count by text patterns (Parlay, Single, etc.)
      if (count === 0) {
        const parlayMatches = body.match(/\d+[- ]?leg parlay/gi);
        const singleMatches = body.match(/single/gi);
        count = (parlayMatches?.length || 0) + (singleMatches?.length || 0);
      }
      // Strategy 3: Count any visible $ wager amounts in the bets area
      if (count === 0) {
        const wagers = body.match(/\$\d+\.\d{2}/g);
        count = Math.floor((wagers?.length || 0) / 2);
      }
      return count;
    });

    return result;
  } catch (e) {
    log(`  Open positions check error: ${e.message.split('\n')[0]}`);
    return -1;
  }
}

