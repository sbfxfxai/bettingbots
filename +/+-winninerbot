// Login check — detects DraftKings logged-in state via page text and elements
async function isLoggedIn(page) {
  const result = await page.evaluate(() => {
    const text = (document.body?.innerText || '').toLowerCase();
    if (text.length < 100) return { logged: false, reason: 'page_too_short', len: text.length };

    // NEGATIVE — if ANY of these exist, definitely NOT logged in
    const negatives = [
      'log in to place bets', 'sign in to place bets',
      'log in to place', 'sign in to place',
      'want to start placing bets', 'must be logged in',
      'sign in to your account', 'log in to your account',
      'sign in to get started',
    ];
    const negHit = negatives.find(p => text.includes(p));
    if (negHit) return { logged: false, reason: `negative: "${negHit}"` };

    // Check for visible "Sign In" / "Log In" buttons (NOT "Join Now" — that appears in promos even when logged in)
    for (const el of document.querySelectorAll('a, button, span')) {
      const t = (el.textContent || '').trim().toLowerCase();
      if (t.length > 20) continue;
      if (t === 'sign in' || t === 'log in') {
        const rect = el.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
          return { logged: false, reason: `button: "${t}" (${el.tagName})` };
        }
      }
    }

    // POSITIVE checks — DraftKings specific
    // 1. Balance with dollar amount (e.g. "Balance$22.94" or "balance\n$22.94")
    if (/balance[^a-z]*\$\d+/i.test(document.body?.innerText || '')) {
      return { logged: true, reason: 'balance_dollar' };
    }
    // 2. "My Bets" link exists AND no "sign in"/"log in" text anywhere
    if (text.includes('my bets') && !text.includes('sign in') && !text.includes('log in')) {
      return { logged: true, reason: 'my_bets_no_signin' };
    }
    // 3. "Last Login:" text (only shown in footer when logged in)
    if (text.includes('last login:')) {
      return { logged: true, reason: 'last_login_text' };
    }
    // 4. "Sign Out" / "Log Out" element
    for (const el of document.querySelectorAll('a, button, span, div')) {
      const t = (el.textContent || '').trim().toLowerCase();
      if (t.length > 20) continue;
      if (t === 'sign out' || t === 'log out' || t === 'logout' || t === 'signout') {
        return { logged: true, reason: `found: "${t}"` };
      }
    }
    // 5. "Deposit" link + large page + no sign-in text
    if (text.length > 2000 && text.includes('deposit') && !text.includes('sign in') && !text.includes('log in')) {
      return { logged: true, reason: 'deposit_no_signin' };
    }

    return { logged: false, reason: 'no_indicator', len: text.length };
  }).catch(() => ({ logged: false, reason: 'error' }));

  if (result.logged) {
    log(`  🔓 isLoggedIn=true (${result.reason})`);
  }
  return result.logged;
}

// Detect explicit "not logged in" state
async function detectNotLoggedIn(page) {
  return page.evaluate(() => {
    const text = (document.body?.innerText || '').toLowerCase();
    if (text.length < 50) return { notLoggedIn: false, loading: true };
    // Check small leaf elements for sign-in buttons
    for (const el of document.querySelectorAll('a, button, span')) {
      const t = (el.textContent || '').trim().toLowerCase();
      if (t.length > 30) continue;
      if (t === 'sign in' || t === 'log in' || t === 'sign up' || t === 'create account') {
        const rect = el.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) return { notLoggedIn: true, reason: t };
      }
    }
    if (/want to start placing bets|sign in to|must be logged in/i.test(text)) {
      return { notLoggedIn: true, reason: 'text_prompt' };
    }
    return { notLoggedIn: false, loading: text.length < 500 };
  }).catch(() => ({ notLoggedIn: false, loading: true }));
}

// Perform the actual login flow (DOM + keyboard fallback)
async function performLogin(page) {
  // Navigate to login page if not already there
  const currentUrl = page.url();
  const onLoginPage = currentUrl.includes('auth/login') || currentUrl.includes('auth/signup') ||
    currentUrl.includes('myaccount.draftkings.com');
  if (!onLoginPage) {
    log('  Clicking "Sign In" to open login page...');
    try {
      await Promise.all([
        page.waitForNavigation({ waitUntil: 'domcontentloaded', timeout: 20000 }).catch(() => {}),
        page.evaluate(() => {
          for (const el of document.querySelectorAll('a, button, span')) {
            const t = (el.textContent || '').trim().toLowerCase();
            if (t === 'sign in' || t === 'log in') { el.click(); return true; }
          }
          return false;
        })
      ]);
    } catch {}
    await new Promise(r => setTimeout(r, 3000));
  }

  // Wait for any login input to appear (up to 20s)
  log('  Waiting for login form...');
  let formFound = false;
  for (let w = 0; w < 20; w++) {
    formFound = await page.evaluate(() => {
      return !!(document.querySelector('#login-username-input') ||
        document.querySelector('input[type="email"]') ||
        document.querySelector('input[name="Email"]') ||
        document.querySelector('input[autocomplete="email"]') ||
        document.querySelector('input[autocomplete="username"]') ||
        document.querySelector('input[type="text"]'));
    }).catch(() => false);
    if (formFound) break;
    await new Promise(r => setTimeout(r, 1000));
  }

  await screenshot(page, 'pre-login');

  // --- Method 1: DOM-based with React setter (most reliable for DK) ---
  let domLoginOk = false;
  const emailFilled = await page.evaluate((email) => {
    // Try specific DK selectors first, then broader ones
    const selectors = [
      '#login-username-input',
      'input[type="email"]',
      'input[name="Email"]',
      'input[autocomplete="email"]',
      'input[autocomplete="username"]',
    ];
    for (const sel of selectors) {
      const input = document.querySelector(sel);
      if (!input) continue;
      const rect = input.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) continue;
      input.focus(); input.value = '';
      const setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
      setter.call(input, email);
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.dispatchEvent(new Event('change', { bubbles: true }));
      return sel;
    }
    // Broader fallback: find by placeholder/label
    for (const input of document.querySelectorAll('input[type="text"], input[type="email"]')) {
      const ph = (input.placeholder || '').toLowerCase();
      const label = (input.getAttribute('aria-label') || '').toLowerCase();
      if (ph.includes('email') || ph.includes('username') || label.includes('email')) {
        input.focus(); input.value = '';
        const setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
        setter.call(input, email);
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
        return 'placeholder-match';
      }
    }
    return null;
  }, DK_EMAIL).catch(() => null);

  if (emailFilled) {
    log(`  Email filled via: ${emailFilled}`);
    await new Promise(r => setTimeout(r, 500));

    // Fill password
    const pwFilled = await page.evaluate((pw) => {
      const input = document.querySelector('#login-password-input') ||
        document.querySelector('input[type="password"]');
      if (!input) return false;
      input.focus(); input.value = '';
      const setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
      setter.call(input, pw);
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.dispatchEvent(new Event('change', { bubbles: true }));
      return true;
    }, DK_PASSWORD).catch(() => false);

    if (pwFilled) {
      log('  Password filled — clicking submit...');
      await new Promise(r => setTimeout(r, 300));
      try {
        await Promise.all([
          page.waitForNavigation({ waitUntil: 'domcontentloaded', timeout: 20000 }).catch(() => {}),
          page.evaluate(() => {
            for (const el of document.querySelectorAll('button[type="submit"], button')) {
              const text = (el.textContent || '').trim().toLowerCase();
              if (text === 'log in' || text === 'sign in' || text === 'submit' || text === 'login') {
                el.click(); return true;
              }
            }
            return false;
          })
        ]);
      } catch {}
      domLoginOk = true;
      log('  DOM login submitted');
    }
  }

  // --- Method 2: Keyboard fallback ---
  if (!domLoginOk) {
    log('  DOM login failed — trying keyboard login...');
    // Try to find and click the first visible text/email input
    const inputClicked = await page.evaluate(() => {
      for (const input of document.querySelectorAll('input[type="email"], input[type="text"], input[autocomplete="email"], input[autocomplete="username"]')) {
        const rect = input.getBoundingClientRect();
        if (rect.width > 30 && rect.height > 10) {
          input.focus(); input.click();
          return { x: rect.x + rect.width / 2, y: rect.y + rect.height / 2 };
        }
      }
      return null;
    }).catch(() => null);

    if (inputClicked) {
      await page.mouse.click(inputClicked.x, inputClicked.y);
      await new Promise(r => setTimeout(r, 300));
      // Select all + delete to clear
      await page.keyboard.down('Control');
      await page.keyboard.press('a');
      await page.keyboard.up('Control');
      await page.keyboard.press('Backspace');
      await new Promise(r => setTimeout(r, 200));
      await page.keyboard.type(DK_EMAIL, { delay: 20 });
      log('  Typed email');
      await new Promise(r => setTimeout(r, 300));
      await page.keyboard.press('Tab');
      await new Promise(r => setTimeout(r, 300));
      // Clear password field too
      await page.keyboard.down('Control');
      await page.keyboard.press('a');
      await page.keyboard.up('Control');
      await page.keyboard.press('Backspace');
      await new Promise(r => setTimeout(r, 200));
      await page.keyboard.type(DK_PASSWORD, { delay: 20 });
      log('  Typed password');
      await new Promise(r => setTimeout(r, 500));
      await page.keyboard.press('Enter');
      log('  Keyboard login submitted');
    } else {
      log('  ⚠️ No login input found at all');
    }
  }

  // Wait for login to process
  await new Promise(r => setTimeout(r, 10000));
  await screenshot(page, 'post-login');

  // After login, navigate back to /live if redirected elsewhere
  if (!page.url().includes('sportsbook.draftkings.com/live')) {
    log('  Navigating back to /live after login...');
    try {
      await page.goto('https://sportsbook.draftkings.com/live', { waitUntil: 'domcontentloaded', timeout: 30000 });
    } catch {}
    await new Promise(r => setTimeout(r, 5000));
  }
}

async function ensureLoggedIn(page, forceReload = false) {
  log('🔑 Checking login status...');

  for (let attempt = 0; attempt < 15; attempt++) {
    // Reload on first attempt if forced (startup)
    if (attempt === 0 && forceReload) {
      try { await page.reload({ waitUntil: 'domcontentloaded', timeout: 30000 }); } catch {}
      await new Promise(r => setTimeout(r, 5000));
    }

    // Check if logged in (strict check)
    const loggedIn = await isLoggedIn(page);
    if (loggedIn) {
      log('✅ Logged in to DraftKings — confirmed');
      return true;
    }

    // Check if page shows login prompt OR is ambiguous
    const detection = await detectNotLoggedIn(page);
    log(`  Login attempt ${attempt + 1}/15: notLoggedIn=${detection.notLoggedIn}, reason=${detection.reason || 'n/a'}, loading=${detection.loading || false}`);

    if (detection.notLoggedIn) {
      // Definite: not logged in → auto-login
      await performLogin(page);
      await new Promise(r => setTimeout(r, 3000));
      if (await isLoggedIn(page)) {
        log('✅ Logged in to DraftKings — confirmed after auto-login');
        return true;
      }
      log('  Auto-login attempt did not succeed — retrying...');

    } else if (detection.loading) {
      // Page still loading — fire-and-forget navigation to DK (don't block on timeout)
      if (attempt === 3 || attempt === 7 || attempt === 11) {
        log('  Page still loading — retrying navigation to DraftKings live...');
        page.goto('https://sportsbook.draftkings.com/live').catch(() => {});
      }
      await new Promise(r => setTimeout(r, 5000));

    } else {
      // Ambiguous: page loaded, no "Sign In" button found, but no "Sign Out" either
      // This means we're probably NOT logged in — try logging in
      log('  Ambiguous state (no sign-in button, no sign-out either) — attempting login...');
      await performLogin(page);
      await new Promise(r => setTimeout(r, 3000));
      if (await isLoggedIn(page)) {
        log('✅ Logged in to DraftKings — confirmed after login');
        return true;
      }
    }
  }

  // Auto-login exhausted — prompt user for manual login
  log('');
  log('╔══════════════════════════════════════════════════════╗');
  log('║  ⚠️  AUTO-LOGIN FAILED — MANUAL LOGIN REQUIRED      ║');
  log('║  Please log in to DraftKings in the Chrome window.  ║');
  log('║  The bot will resume once login is detected.        ║');
  log('╚══════════════════════════════════════════════════════╝');
  log('');
  await screenshot(page, 'manual-login-needed');

  // Poll for manual login (up to 10 minutes)
  for (let w = 0; w < 120; w++) {
    if (await isLoggedIn(page)) {
      log('✅ Manual login detected — resuming bot');
      return true;
    }
    if (w % 12 === 0 && w > 0) log(`  Still waiting for manual login... (${w * 5}s)`);
    await new Promise(r => setTimeout(r, 5000));
  }
  log('❌ Login timed out after 10 minutes');
  return false;
}

