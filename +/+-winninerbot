      if (rect.width > 100) score += 5;
      if (rect.height > 30) score += 3;
      if (rect.x >= 700) score += 3;
      const directText = Array.from(el.childNodes).filter(n => n.nodeType === 3).map(n => n.textContent).join('').trim().toLowerCase();
      if (directText.includes('place bet') || directText.includes('accept change')) score += 8;
      allButtons.push({ text: text.slice(0, 60), score, x: Math.round(rect.x), y: Math.round(rect.y), tag: el.tagName });
      if (score > bestScore) { bestScore = score; best = el; }
    }
    if (!best) return { found: false, allButtons };
    best.scrollIntoView({ block: 'center', behavior: 'instant' });
    best.click();
    const rect = best.getBoundingClientRect();
    return { found: true, tag: best.tagName, score: bestScore, text: (best.textContent || '').trim().toLowerCase().slice(0, 60), x: Math.round(rect.x), y: Math.round(rect.y), allButtons };
