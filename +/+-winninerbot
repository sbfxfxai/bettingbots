// Quick check: is the location banner currently blocking?
async function isLocationBlocked(page) {
  return page.evaluate(() => {
    const t = (document.body?.innerText || '').toLowerCase();
    // Check text indicators
    if (t.includes('trouble verifying your location') ||
        t.includes('verifying your location') ||
        t.includes('you are in a location where betting is unavailable') ||
        t.includes('checking location') ||
        t.includes('location where betting')) return true;
    // Check for the blue/yellow location banner element (may not be in innerText if floating)
    for (const el of document.querySelectorAll('div, section, aside, [role="alert"], [role="banner"], span, p')) {
      const text = (el.textContent || '').trim().toLowerCase();
      const rect = el.getBoundingClientRect();
      if (rect.width < 200 || rect.height < 20 || rect.height > 120) continue;
      if (text.includes('trouble verifying') || text.includes('verifying your location') ||
          text.includes('required to bet') || text.includes('location where betting')) {
        return true;
      }
    }
    return false;
  }).catch(() => true); // assume blocked on error
}

// Click the location recheck banner/arrow using REAL mouse click (DOM .click() doesn't trigger it)
async function clickRecheckLocation(page) {
  // Find the blue banner's bounding box
  const bannerInfo = await page.evaluate(() => {
    // Look for the blue location banner
    for (const el of document.querySelectorAll('div, section, aside, a, [role="alert"], [role="banner"]')) {
      const text = (el.textContent || '').toLowerCase();
      if (!text.includes('location') && !text.includes('verifying')) continue;
      const rect = el.getBoundingClientRect();
      if (rect.height < 10 || rect.height > 200 || rect.width < 200) continue;
      if (rect.y < 0 || rect.y > 500) continue;
      return { x: rect.x, y: rect.y, w: rect.width, h: rect.height, tag: el.tagName };
    }
    return null;
  }).catch(() => null);

  if (!bannerInfo) {
    log('  No location banner found in DOM');
    return null;
  }

  // Real mouse click on the ">" arrow (right side of the blue banner)
  const clickX = bannerInfo.x + bannerInfo.w - 30; // near the right arrow
  const clickY = bannerInfo.y + bannerInfo.h / 2;   // vertically centered
  log(`  Clicking banner arrow at (${Math.round(clickX)}, ${Math.round(clickY)}) [${bannerInfo.tag} ${bannerInfo.w}x${bannerInfo.h}]`);
  await page.mouse.click(clickX, clickY);
  await new Promise(r => setTimeout(r, 2000));

  // Also try clicking the banner center as backup
  const centerX = bannerInfo.x + bannerInfo.w / 2;
  await page.mouse.click(centerX, clickY);

  log('  Location recheck clicked (mouse)');
  // Wait for GeoComply to process
  await new Promise(r => setTimeout(r, 8000));

  // Navigate back to /live if needed
  if (!page.url().includes('/live')) {
    try { await page.goto('https://sportsbook.draftkings.com/live?category=live-in-game&subcategory=basketball', { waitUntil: 'domcontentloaded', timeout: 20000 }); } catch {}
    await new Promise(r => setTimeout(r, 5000));
  }
  return 'mouse';
}

// Ensure location is verified — NEVER gives up, loops forever until verified
async function ensureLocationVerified(page) {
  let attempt = 0;
  while (true) {
    const blocked = await isLocationBlocked(page);
    if (!blocked) return true;
    attempt++;
    const phase = ((attempt - 1) % 4) + 1; // cycles 1→2→3→4→1→2→3→4…
    log(`⚠️ Location blocked (attempt ${attempt}, strategy ${phase}/4)`);
    if (attempt <= 3 || attempt % 5 === 0) await screenshot(page, `location-recheck-${attempt}`);

    if (phase === 1) {
      // Phase 1: click recheck button
      log('  Clicking recheck...');
      const clicked = await clickRecheckLocation(page);
      if (!clicked) log('  No recheck element found');
      await new Promise(r => setTimeout(r, 5000));

    } else if (phase === 2) {
      // Phase 2: hard page reload to reset GeoComply
      log('  🔄 Hard reload to reset GeoComply...');
      try { await page.reload({ waitUntil: 'domcontentloaded', timeout: 30000 }); } catch {}
      await new Promise(r => setTimeout(r, 12000));

    } else if (phase === 3) {
      // Phase 3: navigate completely away then back
      log('  🔄 Full re-navigation to reset location...');
      try { await page.goto('https://sportsbook.draftkings.com/', { waitUntil: 'domcontentloaded', timeout: 30000 }); } catch {}
      await new Promise(r => setTimeout(r, 8000));
      try { await page.goto('https://sportsbook.draftkings.com/live?category=live-in-game&subcategory=basketball', { waitUntil: 'domcontentloaded', timeout: 30000 }); } catch {}
      await new Promise(r => setTimeout(r, 12000));

    } else {
      // Phase 4: click recheck + longer cool-down before cycling back
      log('  Clicking recheck + cool-down before next cycle...');
      await clickRecheckLocation(page);
      await new Promise(r => setTimeout(r, 15000));
    }
  }
}

// Navigate to DK and wait for content — uses fire-and-forget nav to avoid blocking timeouts
async function ensurePageLoaded(page) {
  const currentUrl = page.url();
  const onDK = currentUrl.includes('sportsbook.draftkings.com');
  const isBlank = currentUrl === 'about:blank' || currentUrl.startsWith('chrome-error://') || currentUrl === 'chrome://newtab/';

  // Check current content
  const contentLen = await page.evaluate(() => (document.body?.innerText || '').length).catch(() => 0);

  if (!onDK || isBlank) {
    log(`Navigating to DK live (current: ${isBlank ? 'blank' : currentUrl.substring(0, 60)})...`);
    page.goto('https://sportsbook.draftkings.com/live').catch(() => {});
  } else if (contentLen < 200) {
    log('On DK but page is nearly empty — triggering reload...');
    page.reload().catch(() => {});
  } else {
    log(`On DK with content (${contentLen} chars)`);
    return true;
  }

  // Poll for content (up to 90s — DK SPA can be very slow on first load)
  for (let w = 0; w < 45; w++) {
    const len = await page.evaluate(() => {
      const text = document.body?.innerText || '';
      if (/ERR_|DNS_|INTERNET_DISCONNECTED|This site can.t be reached/i.test(text)) return -1;
      return text.length;
    }).catch(() => 0);

    if (len > 500) {
      log(`Page loaded (${len} chars)`);
      return true;
    }
    if (len === -1) {
      log('  Error page detected — retrying navigation...');
      page.goto('https://sportsbook.draftkings.com/live').catch(() => {});
    }
    if (w === 20) {
      log('  Still loading after 40s — retrying navigation...');
      page.goto('https://sportsbook.draftkings.com/live').catch(() => {});
    }
    if (w % 10 === 0 && w > 0) log(`  Waiting for page content... (${w * 2}s)`);
    await new Promise(r => setTimeout(r, 2000));
  }
  log('⚠️ Page still not loaded after 90s');
  return false;
}

async function verifyLocation(page) {
  // Step 1: Make sure the page is loaded with real content
  const loaded = await ensurePageLoaded(page);
  if (!loaded) return false;

  // Step 2: Check and resolve location — loops forever until verified
  await ensureLocationVerified(page);
  log('✅ Location verified');
  return true;
}

// ─── Scrape Live Games ───────────────────────────────────────────────────────
async function scrapeGames(page) {
  // Expand collapsed sections first
  await page.evaluate((sel) => {
    document.querySelectorAll(sel).forEach(btn => btn.click());
  }, SEL.collapsed).catch(() => {});
  await new Promise(r => setTimeout(r, 150));

  // DK uses virtualized rendering — only visible games exist in the DOM.
  // Scroll through the page and accumulate games at each viewport position.
  await page.evaluate(() => window.scrollTo(0, 0)).catch(() => {});
  await new Promise(r => setTimeout(r, 100));

  const allGames = [];
  const seenKeys = new Set();

  let noNewCount = 0;
  for (let scrollPass = 0; scrollPass < 30; scrollPass++) {
    // Expand any newly revealed collapsed sections
    await page.evaluate((sel) => {
      document.querySelectorAll(sel).forEach(btn => btn.click());
    }, SEL.collapsed).catch(() => {});

    const viewportGames = await page.evaluate((sel) => {
      const games = [];
      const blocks = Array.from(document.querySelectorAll(sel.gameBlock))
        .filter(b => b.querySelector(sel.gameBlockFilter));

      blocks.forEach(block => {
        const rect = block.getBoundingClientRect();
        if (rect.x >= 700 || rect.width === 0) return;

        const teamEls = block.querySelectorAll(sel.teamName);
        const teamData = [];
        teamEls.forEach(el => {
          const name = (el.textContent || '').trim();
          if (name && name.length > 1) {
            const r = el.getBoundingClientRect();
            teamData.push({ name, y: r.y + r.height / 2 });
          }
        });

        const scoreEls = block.querySelectorAll(sel.score);
        const scoreData = [];
        scoreEls.forEach(el => {
          const text = (el.textContent || '').trim();
          const r = el.getBoundingClientRect();
          if (text !== '' && text !== '-' && text !== '–' && text !== '—') scoreData.push({ text, y: r.y + r.height / 2, x: r.x });
        });

        let scores1 = [], scores2 = [];
        if (teamData.length >= 2 && scoreData.length >= 2) {
          const midY = (teamData[0].y + teamData[1].y) / 2;
          for (const s of scoreData) {
            if (s.y < midY) scores1.push(s);
            else scores2.push(s);
          }
          scores1.sort((a, b) => a.x - b.x);
          scores2.sort((a, b) => a.x - b.x);
        } else if (scoreData.length >= 2) {
          const half = Math.ceil(scoreData.length / 2);
          scores1 = scoreData.slice(0, half);
          scores2 = scoreData.slice(half);
        }

        const buttons = block.querySelectorAll(sel.oddsButton);
        const odds = [];
        buttons.forEach(btn => {
          const oddsEl = btn.querySelector(sel.oddsValue) || btn;
          const pointsEl = btn.querySelector(sel.oddsPoints);
          const titleEl = btn.querySelector(sel.oddsTitle);
          const oddsText = (oddsEl.textContent || '').trim();
          odds.push({
            value: oddsText,
            points: pointsEl ? (pointsEl.textContent || '').trim() : '',
            title: titleEl ? (titleEl.textContent || '').trim() : '',
            idx: odds.length,
          });
        });

        const moneylines = [];
        odds.forEach(o => {
          const t = (o.title || '').toUpperCase();
          const p = (o.points || '').trim();
          if (t === 'O' || t === 'U' || p.startsWith('+') || p.startsWith('-') ||
              p.toUpperCase() === 'PK' || p.toUpperCase().startsWith('O ') || p.toUpperCase().startsWith('U ')) return;
          moneylines.push(o);
        });

        const periodEl = block.querySelector(sel.period) || (block.parentElement && block.parentElement.querySelector(sel.period));
        const clockEl = block.querySelector(sel.clock) || (block.parentElement && block.parentElement.querySelector(sel.clock));
        const period = periodEl ? (periodEl.textContent || '').trim() : '';
        const clock = clockEl ? (clockEl.textContent || '').trim() : '';

        const score1Raw = scores1.map(s => s.text);
        const score2Raw = scores2.map(s => s.text);
        const hasScore = score1Raw.length > 0 || score2Raw.length > 0;
        const isLive = hasScore || period || clock;

        if (teamData.length >= 2 && isLive) {
          // Filter out Draw/X for soccer 3-way ML, then take first=Home, last=Away
          const drawTitles = ['X', 'DRAW', 'TIE', 'D'];
          const nonDraw = moneylines.filter(o => !drawTitles.includes((o.title || '').toUpperCase()));
          const ml1 = nonDraw[0] || null;
          const ml2 = nonDraw.length >= 2 ? (nonDraw[nonDraw.length - 1] || null) : (nonDraw[0] === ml1 ? null : nonDraw[0] || null);

          // Find nearest league heading above this block in the DOM
          let league = '';
          let el = block;
          while (el && el !== document.body) {
            el = el.parentElement;
            if (!el) break;
            const heading = el.querySelector(sel.leagueHeading);
            if (heading) { league = (heading.textContent || '').trim(); break; }
          }

          games.push({
            team1: teamData[0].name, team2: teamData[1].name,
            score1: score1Raw[score1Raw.length - 1] || '0', score2: score2Raw[score2Raw.length - 1] || '0',
            rawScores1: score1Raw, rawScores2: score2Raw,
            period, clock,
            ml1, ml2,
            league,
            oddsCount: odds.length, mlCount: moneylines.length,
            allOdds: odds.slice(0, 20).map(o => `${o.value}|${o.points}|${o.title}`),
          });
        }
      });
      return games;
    }, SEL).catch(() => []);

    // Deduplicate and accumulate
    const prevCount = allGames.length;
    for (const g of viewportGames) {
      const key = [g.team1, g.team2].sort().join('|').toLowerCase();
      if (!seenKeys.has(key)) {
        seenKeys.add(key);
        allGames.push(g);
      }
    }

    // Track if this pass found anything new
    if (allGames.length === prevCount) noNewCount++;
    else noNewCount = 0;
    if (noNewCount >= 3) break;

    // Scroll down by full viewport
    const atBottom = await page.evaluate(() => {
      if (!document.body) return true;
      window.scrollBy(0, window.innerHeight * 0.8);
      return window.scrollY + window.innerHeight >= document.body.scrollHeight - 50;
    }).catch(() => true);
    await new Promise(r => setTimeout(r, 250));

    if (atBottom) break;
  }

  // Scroll back to top when done
  await page.evaluate(() => window.scrollTo(0, 0)).catch(() => {});
  return allGames;
}

// ─── Pick Winner ─────────────────────────────────────────────────────────────
// Only returns the team/player that is currently WINNING. Tied games are skipped.
// Sport-specific score parsing ensures accuracy across all sport types.
function pickWinner(game, sport = '') {
  const sportUp = (sport || '').toUpperCase();

  // --- Parse primary scores based on sport ---
  let s1, s2;

  if (sportUp.includes('TABLE')) {
    // Table Tennis: DK shows set scores + rightmost = sets won total
    // Use rightmost raw score (sets won) for comparison
    const r1 = game.rawScores1 || [];
    const r2 = game.rawScores2 || [];
    s1 = parseInt(r1[r1.length - 1] || game.score1 || '0', 10) || 0;
    s2 = parseInt(r2[r2.length - 1] || game.score2 || '0', 10) || 0;
  } else if (sportUp.includes('TENNIS')) {
    // Tennis: DK shows [gamePoints, set1Games, set2Games, ...]
    // Leftmost (green) = current game points (0,15,30,40,AD) — skip it
    // Remaining = games per set — count completed sets to determine leader
    const r1 = (game.rawScores1 || []).map(v => parseInt(v, 10));
    const r2 = (game.rawScores2 || []).map(v => parseInt(v, 10));
    // Skip first element (game points) if there are multiple scores
    const sets1 = r1.length > 1 ? r1.slice(1) : r1;
    const sets2 = r2.length > 1 ? r2.slice(1) : r2;
    let won1 = 0, won2 = 0;
    for (let i = 0; i < Math.min(sets1.length, sets2.length); i++) {
      const g1 = sets1[i], g2 = sets2[i];
      if (isNaN(g1) || isNaN(g2)) continue;
      // Set complete: one player has ≥6 games and leads by ≥2, or tiebreak 7-6
      if ((g1 >= 6 && g1 - g2 >= 2) || (g1 === 7 && g2 === 6)) won1++;
      else if ((g2 >= 6 && g2 - g1 >= 2) || (g2 === 7 && g1 === 6)) won2++;
    }
    s1 = won1; s2 = won2;
    // If sets tied, use current set games as tiebreaker
    if (s1 === s2 && sets1.length > 0 && sets2.length > 0) {
      const curG1 = sets1[sets1.length - 1] || 0;
      const curG2 = sets2[sets2.length - 1] || 0;
      if (!isNaN(curG1) && !isNaN(curG2) && curG1 !== curG2) { s1 = curG1; s2 = curG2; }
    }
  } else if (sportUp.includes('CRICKET')) {
    // Cricket: score format "runs/wickets" (e.g., "129/9")
    // Compare runs only — parseInt naturally extracts runs from "129/9"
    s1 = parseInt((game.score1 || '0').replace(/\/.*/, ''), 10) || 0;
    s2 = parseInt((game.score2 || '0').replace(/\/.*/, ''), 10) || 0;
  } else {
    // Basketball, Hockey, Soccer, Baseball, Handball, etc.: cumulative integer scores
    s1 = parseInt(game.score1 || '0', 10) || 0;
    s2 = parseInt(game.score2 || '0', 10) || 0;
  }

  // Tied or 0-0 — skip entirely
  if (s1 === s2) return null;

  const winnerIdx = s1 > s2 ? 0 : 1;
  const winnerML = winnerIdx === 0 ? game.ml1 : game.ml2;
  if (!winnerML || !winnerML.value) return null;

  // No ML filtering — ALWAYS bet the score leader.
  // + odds on a team that's currently winning = maximum value.

  const winnerTeam = winnerIdx === 0 ? game.team1 : game.team2;
  return {
    team: winnerTeam,
    odds: winnerML.value,
    buttonIndex: winnerML.idx,
    team1: game.team1,
    team2: game.team2,
    score: `${s1}-${s2}`,
    rawScores: { t1: game.rawScores1 || [], t2: game.rawScores2 || [] },
    period: game.period,
    clock: game.clock,
  };
}

// ─── Shared: build labeled candidates from all buttons ───────────────────────
function buildCandidates(game) {
  const allOdds = game.allOdds || [];
  const candidates = [];
  for (let i = 0; i < allOdds.length; i++) {
    const parts  = allOdds[i].split('|');
    const value  = parts[0] || '';
    const points = parts[1] || '';
    const title  = (parts[2] || '').toUpperCase();
    const pUp    = points.toUpperCase();
    const num    = parseAmericanOdds(value);
    if (isNaN(num)) continue;
    let type;
    if (title === 'O' || title === 'OVER' || pUp.startsWith('O ') || pUp.startsWith('OVER '))
      type = `OVER ${points}`;
    else if (title === 'U' || title === 'UNDER' || pUp.startsWith('U ') || pUp.startsWith('UNDER '))
      type = `UNDER ${points}`;
    else if (points.startsWith('+') || points.startsWith('-'))
      type = `SPREAD ${points}`;
    else
      type = `ML ${title || points}`;
    candidates.push({ num, value, points, title, type, buttonIndex: i });
  }
  return candidates;
}

function makePick(game, best) {
  const s1 = parseInt(game.score1 || '0', 10) || 0;
  const s2 = parseInt(game.score2 || '0', 10) || 0;
  return {
    team: best.type, label: `${best.type} @ ${best.value}`,
    odds: best.value, buttonIndex: best.buttonIndex,
    team1: game.team1, team2: game.team2,
    score: `${s1}-${s2}`, points: best.points,
    period: game.period, clock: game.clock,
  };
}

// Strategy A — + odds closest to +100 (lowest positive number)
function pickOU(game, sport = '') {
  const pos = buildCandidates(game).filter(c => c.value.trim().startsWith('+') && c.num > 0);
  if (pos.length === 0) return null;
  pos.sort((a, b) => a.num - b.num);
  return makePick(game, pos[0]);
}

// Strategy B — - odds closest to -100 (least negative: highest num that is still < 0)
function pickClosestNeg(game, sport = '') {
  const neg = buildCandidates(game).filter(c => c.num < 0);
  if (neg.length === 0) return null;
  neg.sort((a, b) => b.num - a.num); // -101 > -110 > -200
  return makePick(game, neg[0]);
}

// Strategy C — winning team ML (current score leader, any odds)
function pickWinningTeamML(game, sport = '') {
  const s1 = parseInt(game.score1 || '0', 10) || 0;
  const s2 = parseInt(game.score2 || '0', 10) || 0;
  if (s1 === s2) return null; // tied — skip
  const winnerIdx = s1 > s2 ? 0 : 1;
  const ml = winnerIdx === 0 ? game.ml1 : game.ml2;
  if (!ml || !ml.value) return null;
  const winnerTeam = winnerIdx === 0 ? game.team1 : game.team2;
  return {
    team: winnerTeam, label: `ML ${winnerTeam} @ ${ml.value}`,
    odds: ml.value, buttonIndex: ml.idx,
    team1: game.team1, team2: game.team2,
    score: `${s1}-${s2}`, points: '',
    period: game.period, clock: game.clock,
  };
}

// ─── Click Odds Button ───────────────────────────────────────────────────────
async function clickMoneyline(page, pick) {
  return page.evaluate((target, sel) => {
    const norm = s => (s || '').replace(/\s+/g, ' ').trim();
    const blocks = Array.from(document.querySelectorAll(sel.gameBlock))
      .filter(b => b.querySelector(sel.gameBlockFilter));

    const matchBlock = blocks.find(block => {
      const teams = Array.from(block.querySelectorAll(sel.teamName)).map(el => norm(el.textContent));
      return teams.includes(norm(target.team1)) && teams.includes(norm(target.team2));
    });

    if (!matchBlock) return null;
    matchBlock.scrollIntoView({ block: 'center', behavior: 'instant' });

    const buttons = Array.from(matchBlock.querySelectorAll(sel.oddsButton));

    // Try button index first (fastest)
    if (target.buttonIndex >= 0 && target.buttonIndex < buttons.length) {
      buttons[target.buttonIndex].click();
      return 'index';
    }
    // Fallback: match by O/U title
    const side = (target.team || '').toUpperCase();
    if (side === 'OVER' || side === 'UNDER') {
      const titleChar = side === 'OVER' ? 'O' : 'U';
      for (const btn of buttons) {
        const titleEl = btn.querySelector(sel.oddsTitle);
        const t = titleEl ? (titleEl.textContent || '').trim().toUpperCase() : '';
        if (t === titleChar || t === side) { btn.click(); return 'title'; }
      }
    }
    // Fallback: match odds text
    for (const btn of buttons) {
      const oddsEl = btn.querySelector(sel.oddsValue) || btn;
      if (norm(oddsEl.textContent) === norm(target.odds)) { btn.click(); return 'text_match'; }
    }
    return null;
  }, pick, SEL);
}

