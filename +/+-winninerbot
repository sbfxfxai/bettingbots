  '--disable-features=BlockInsecurePrivateNetworkRequests,PrivateNetworkAccessRespectPreflightResults,PrivateNetworkAccessChecks,PrivateNetworkAccessForWorkers,PrivateNetworkAccessForNavigations',
];

function killChromeOnPort() {
  try {
    const out = execSync(
      `netstat -ano | findstr ":${DEBUG_PORT}" | findstr "LISTENING"`,
      { encoding: 'utf8', timeout: 5000 }
    ).trim();
    const pids = new Set();
    for (const line of out.split('\n')) {
      const parts = line.trim().split(/\s+/);
      const pid = parts[parts.length - 1];
      if (pid && /^\d+$/.test(pid) && pid !== '0') pids.add(pid);
    }
    for (const pid of pids) {
      log(`Killing Chrome (PID ${pid}) on port ${DEBUG_PORT}...`);
      try { execSync(`taskkill /F /PID ${pid}`, { timeout: 5000 }); } catch {}
    }
    return pids.size;
  } catch {
    return 0;
  }
}

// Spawn Chrome as a DETACHED process (survives bot restarts)
function spawnDetachedChrome(url) {
  const args = [...CHROME_ARGS];
  if (url) args.push(url);
  const proc = spawn(CHROME_PATH, args, { stdio: 'ignore', detached: true });
  proc.unref(); // Let Chrome outlive this process
  return proc;
}

async function connectBrowser() {
  let browser;

  // Try connecting to existing Chrome (fast — preserves session + warm connections)
  for (let attempt = 0; attempt < 3; attempt++) {
    try {
      browser = await puppeteer.connect({ browserURL: `http://127.0.0.1:${DEBUG_PORT}`, defaultViewport: null });
      log('Connected to existing Chrome on port ' + DEBUG_PORT);
      break;
    } catch {
      if (attempt === 0) {
        log('No Chrome found — spawning detached Chrome with CORS flags...');
        spawnDetachedChrome('https://sportsbook.draftkings.com/live');
        log('Chrome spawned — waiting for debug port...');
        await new Promise(r => setTimeout(r, 5000));
      } else {
        log(`  Connect retry ${attempt + 1}/3...`);
        await new Promise(r => setTimeout(r, 3000));
      }
    }
  }

  if (!browser) {
    log('Still cannot connect — killing stale Chrome and respawning...');
    killChromeOnPort();
    await new Promise(r => setTimeout(r, 3000));
    spawnDetachedChrome('https://sportsbook.draftkings.com/live');
    await new Promise(r => setTimeout(r, 6000));
    browser = await puppeteer.connect({ browserURL: `http://127.0.0.1:${DEBUG_PORT}`, defaultViewport: null });
    log('Connected after respawn');
  }

  // Find or create a page
  const pages = await browser.pages();
  let page = pages.find(p => {
    try { return !p.isClosed() && p.url().includes('draftkings.com'); } catch { return false; }
  });
  if (!page) {
    page = pages.find(p => { try { return !p.isClosed(); } catch { return false; } });
    if (!page) page = await browser.newPage();
  }

  page.setDefaultNavigationTimeout(60000);
  page.setDefaultTimeout(30000);

  return { browser, page };
}

