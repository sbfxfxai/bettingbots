const OU_THRESHOLDS = {
  BASKETBALL:   5,    // ~5 points (NBA/college)
  HOCKEY:       0.8,  // ~1 goal
  HANDBALL:     2.5,  // ~2-3 goals
  SOCCER:       0.5,  // ~0.5 goals
